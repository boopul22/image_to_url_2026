{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"account_id": "ab54ca2d01df4886aa0c3f240ace806d",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "imagetourl-pro-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{
			"pattern": "pro.imagetourl.cloud",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"services": [
		{
			"binding": "AUTH_API",
			"service": "imagetourl2026"
		}
	],
	"vars": {
		"SITE_URL": "https://pro.imagetourl.cloud",
		"AUTH_API_ORIGIN": "https://imagetourl.cloud",
		"MAX_UPLOAD_BYTES": "52428800",
		"STORAGE_LIMIT_BYTES": "53687091200",
		"STORAGE_ADDON_BYTES": "53687091200",
		"PADDLE_ENVIRONMENT": "production",
		"PADDLE_PRO_MONTHLY_PRICE_ID": "pri_01kymyp901jkpahectcbvhv2xk",
		"PADDLE_PRO_ANNUAL_PRICE_ID": "pri_01kymyp99v8fq5wva28t78cd2h",
		"PADDLE_STORAGE_ADDON_MONTHLY_PRICE_ID": "pri_01kymyp9w6j7g5esz8jvtrvjcq",
		"PADDLE_STORAGE_ADDON_ANNUAL_PRICE_ID": "pri_01kymypa4pwy961gejhbxjr14q"
	},
	"d1_databases": [
		{
			"binding": "PRO_DB",
			"database_name": "imagetourl-pro-db",
			"database_id": "2bfd1580-c88a-4110-9ba3-a957a30813da"
		}
	],
	"r2_buckets": [
		{
			"binding": "PRO_STORAGE",
			"bucket_name": "imagetourl-pro-storage"
		}
	]
}
