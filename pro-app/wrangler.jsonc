{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"account_id": "ab54ca2d01df4886aa0c3f240ace806d",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "imagetourl-pro-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{
			"pattern": "pro.imagetourl.cloud",
			"custom_domain": true
		},
		{
			"pattern": "imagetourl.cloud/pro",
			"zone_name": "imagetourl.cloud"
		},
		{
			"pattern": "imagetourl.cloud/pro/*",
			"zone_name": "imagetourl.cloud"
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"services": [
		{
			"binding": "AUTH_API",
			"service": "imagetourl2026"
		}
	],
	"vars": {
		"SITE_URL": "https://imagetourl.cloud/pro",
		"AUTH_API_ORIGIN": "https://imagetourl.cloud",
		"MAX_UPLOAD_BYTES": "67108864",
		"PADDLE_ENVIRONMENT": "production",
		"PADDLE_PRO_MONTHLY_PRICE_ID": "pri_01kzkmw3cp16eg0sy86kznsftq",
		"PADDLE_PRO_ANNUAL_PRICE_ID": "pri_01kzkmwjs2t1ythh5w1sgcmkjk",
		"PADDLE_PRO_THREE_YEAR_PRICE_ID": "pri_01kzkmxcc0e53dpb0rm8sefhk7"
	},
	"d1_databases": [
		{
			"binding": "PRO_DB",
			"database_name": "imagetourl-pro-db",
			"database_id": "2bfd1580-c88a-4110-9ba3-a957a30813da"
		}
	],
	"r2_buckets": [
		{
			"binding": "PRO_STORAGE",
			"bucket_name": "imagetourl-pro-storage"
		}
	]
}
