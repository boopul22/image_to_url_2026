# Local-only example. Never commit real Paddle credentials.
# Production values are Cloudflare Worker secrets set with `wrangler secret put`.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=pdl_live_apikey_replace_me
PADDLE_CLIENT_TOKEN=live_replace_me
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_replace_me

PADDLE_PRO_MONTHLY_PRICE_ID=pri_replace_me
PADDLE_PRO_ANNUAL_PRICE_ID=pri_replace_me
PADDLE_PRO_THREE_YEAR_PRICE_ID=pri_replace_me

SITE_URL=https://imagetourl.cloud/pro
AUTH_API_ORIGIN=https://imagetourl.cloud
MAX_UPLOAD_BYTES=67108864
