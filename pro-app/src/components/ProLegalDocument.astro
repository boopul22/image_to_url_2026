---
import ProMarketingShell from '../layouts/ProMarketingShell.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
}

const { title, description, eyebrow, intro } = Astro.props;
---

<ProMarketingShell title={`${title} — ImageToURL Pro`} description={description}>
  <main class="pro-legal-shell">
    <header class="pro-legal-hero">
      <p class="marketing-kicker">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{intro}</p>
      <span>Effective and last updated July 28, 2026</span>
    </header>

    <div class="pro-legal-layout">
      <aside>
        <p>Legal centre</p>
        <nav>
          <a href="/terms">Terms of Service</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/refund-policy">Refund Policy</a>
          <a href="/acceptable-use-policy">Acceptable Use</a>
          <a href="/contact">Contact</a>
        </nav>
        <div>
          <span>Service operator</span>
          <strong>Bipul Kumar</strong>
          <span>ImageToURL · India</span>
        </div>
      </aside>
      <article class="pro-legal-document">
        <slot />
      </article>
    </div>
  </main>
</ProMarketingShell>
