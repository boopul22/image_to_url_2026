---
import '@fontsource-variable/figtree';
import '@fontsource-variable/figtree/wght-italic.css';
import '../styles/pro.css';
import '../styles/marketing.css';
import { proAbsoluteUrl, proPath } from '../lib/paths';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ProInterestTracker from '../components/ProInterestTracker.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'ImageToURL Pro — Permanent image hosting',
  description = 'A focused image workspace with permanent URLs, original-quality storage, private assets, and simple pricing.',
  noindex = false,
} = Astro.props;

const canonical = proAbsoluteUrl(
  Astro.url.pathname.startsWith('/pro')
    ? Astro.url.pathname.slice('/pro'.length) || '/'
    : Astro.url.pathname,
);
const user = Astro.locals.proUser;
const proTrackingPageEvent = Astro.url.pathname.replace(/\/+$/, '').endsWith('/pricing') ? 'pro_pricing_viewed' : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#034f46" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={proPath('/favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ImageToURL Pro" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="marketing-body">
    <GoogleAnalytics userId={user?.id} />
    <header class="marketing-header">
      <a class="marketing-brand" href={user ? proPath('/workspace') : proPath()} aria-label={user ? 'Open ImageToURL Pro workspace' : 'ImageToURL Pro home'}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">image to url</span>
        <span class="pro-chip">PRO</span>
      </a>
      <nav class="marketing-nav" aria-label="Marketing navigation">
        <a href={proPath('/pricing')}>Pricing</a>
        <a href={proPath('/privacy')}>Privacy</a>
        <a href={proPath('/contact')}>Contact</a>
      </nav>
      <div class="marketing-actions">
        <a class="marketing-back" href="https://imagetourl.cloud">Free tools</a>
        {user ? (
          <>
            <a class="marketing-signout" href={proPath('/sign-out')}>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10" />
              </svg>
              <span>Sign out</span>
            </a>
            <a class="marketing-login" href={proPath('/workspace')}>Open workspace</a>
          </>
        ) : (
          <a class="marketing-login" href={`${proPath('/sign-in')}?return_to=${encodeURIComponent(proPath('/workspace'))}`}>Sign in</a>
        )}
      </div>
    </header>

    <slot />

    <ProInterestTracker pageEvent={proTrackingPageEvent} pageLocation="pro-pricing" />

    <footer class="marketing-footer">
      <div class="marketing-footer-brand">
        <a class="marketing-brand" href={user ? proPath('/workspace') : proPath()} aria-label={user ? 'Open ImageToURL Pro workspace' : 'ImageToURL Pro home'}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">image to url</span>
          <span class="pro-chip">PRO</span>
        </a>
        <p>Permanent image URLs and a calmer place to manage them.</p>
      </div>
      <nav aria-label="Product links">
        <strong>Product</strong>
        <a href={proPath('/pricing')}>Pricing</a>
        <a href={user ? proPath('/workspace') : `${proPath('/sign-in')}?return_to=${encodeURIComponent(proPath('/workspace'))}`}>Workspace</a>
        <a href="https://imagetourl.cloud">Free ImageToURL</a>
      </nav>
      <nav aria-label="Legal links">
        <strong>Legal</strong>
        <a href={proPath('/terms')}>Terms of Service</a>
        <a href={proPath('/privacy')}>Privacy Policy</a>
        <a href={proPath('/refund-policy')}>Refund Policy</a>
        <a href={proPath('/acceptable-use-policy')}>Acceptable Use</a>
      </nav>
      <nav aria-label="Support links">
        <strong>Support</strong>
        <a href={proPath('/contact')}>Contact</a>
        <a href="https://paddle.net" target="_blank" rel="noopener">Paddle buyer support</a>
        <a href="mailto:blog.boopul@gmail.com">Email support</a>
      </nav>
      <div class="marketing-footer-base">
        <span>© {new Date().getFullYear()} ImageToURL · Operated by Bipul Kumar</span>
        <span>Payments and taxes handled securely by Paddle.</span>
      </div>
    </footer>
  </body>
</html>
