          setMobileNavActive(link);
          const selector = link.getAttribute('href');
          if (!selector?.startsWith('#') || selector === '#workspace-settings') return;
          const target = document.querySelector<HTMLElement>(selector);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          window.history.replaceState(
            {},
            '',
            `${window.location.pathname}${window.location.search}${selector}`
          );
        });
      });

      const mobileSections = ['#workspace-top', '#recent', '#toolkit']
        .map((selector) => document.querySelector<HTMLElement>(selector))
        .filter((section): section is HTMLElement => Boolean(section));

      if ('IntersectionObserver' in window) {
        const mobileNavObserver = new IntersectionObserver(
          (entries) => {
            const visibleEntry = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visibleEntry) return;
            const matchingLink = document.querySelector<HTMLAnchorElement>(
              `.mobile-nav a[href="#${visibleEntry.target.id}"]`
            );
            if (matchingLink) setMobileNavActive(matchingLink);
          },
          { rootMargin: '-18% 0px -62% 0px', threshold: [0.05, 0.25, 0.5] }
        );
        mobileSections.forEach((section) => mobileNavObserver.observe(section));
      }

	    const setFolderDialogMode = (id: string | null, name = '') => {
	      editingFolderId = id;
	      if (folderName) folderName.value = name;
	      if (folderDialogTitle) folderDialogTitle.textContent = id ? 'Manage folder' : 'Create a new folder';
	      if (folderSubmitButton) folderSubmitButton.textContent = id ? 'Save folder' : 'Create folder';
	      if (deleteFolderButton) deleteFolderButton.hidden = !id;
	    };

	    commandSearch?.addEventListener('click', focusAssetSearch);
	    newFolderButton?.addEventListener('click', () => {
        if (!proAccessEnabled) {
          requestUploadAccess();
          return;
        }
	      setFolderDialogMode(null);
	      openDialog(folderDialog);
	      window.setTimeout(() => folderName?.focus(), 50);
	    });
	    document.querySelectorAll<HTMLButtonElement>('[data-folder-manage]').forEach((button) => {
	      button.addEventListener('click', () => {
	        const id = button.dataset.folderManage;
	        if (!id) return;
	        setFolderDialogMode(id, button.dataset.folderName ?? '');
	        openDialog(folderDialog);
	        window.setTimeout(() => folderName?.focus(), 50);
	      });
	    });
	    manageWorkspaceButton?.addEventListener('click', () => openDialog(workspaceDialog));
	    profileButton?.addEventListener('click', () => openDialog(workspaceDialog));
      sidebarBillingButton?.addEventListener('click', () => {
        openDialog(workspaceDialog);
        window.setTimeout(() => billingActionButton?.focus(), 80);
      });
	    document.querySelectorAll<HTMLAnchorElement>('a[href="#workspace-settings"]').forEach((link) => {
	      link.addEventListener('click', (event) => {
	        event.preventDefault();
	        openDialog(workspaceDialog);
	      });
	    });

	    document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
	      button.addEventListener('click', () => closeDialog(button.closest<HTMLDialogElement>('dialog')));
	    });
	    [folderDialog, assetDialog, workspaceDialog, uploadResultDialog].forEach((dialog) => {
	      dialog?.addEventListener('click', (event) => {
	        if (event.target === dialog) closeDialog(dialog);
	      });
	    });

	    folderForm?.addEventListener('submit', async (event) => {
	      event.preventDefault();
	      const name = folderName?.value.trim();
	      if (!name) return;
	      const target = editingFolderId
	        ? `/pro/api/folders/${encodeURIComponent(editingFolderId)}`
	        : '/pro/api/folders';
	      if (folderSubmitButton) folderSubmitButton.disabled = true;
	      const response = await fetch(target, {
	        method: editingFolderId ? 'PATCH' : 'POST',
	        headers: { 'Content-Type': 'application/json' },
	        body: JSON.stringify({ name })
	      });
	      const result = await response.json().catch(() => ({ error: 'Folder update failed' })) as { error?: string };
	      if (folderSubmitButton) folderSubmitButton.disabled = false;
	      if (!response.ok) {
          if (response.status === 402) {
            closeDialog(folderDialog);
            requestUploadAccess(result.error);
            return;
          }
	        showToast(result.error || 'Folder update failed');
	        return;
	      }
	      window.sessionStorage.setItem(
	        'imagetourl-pro-flash',
	        editingFolderId ? `Folder renamed to “${name}”` : `“${name}” folder created`
	      );
	      window.location.reload();
	    });

	    deleteFolderButton?.addEventListener('click', async () => {
	      if (!editingFolderId) return;
	      const name = folderName?.value.trim() || 'this folder';
	      if (!window.confirm(`Delete “${name}”? Its images will move to Unfiled and remain available.`)) return;
	      deleteFolderButton.disabled = true;
	      const response = await fetch(`/pro/api/folders/${encodeURIComponent(editingFolderId)}`, {
	        method: 'DELETE'
	      });
	      const result = await response.json().catch(() => ({ error: 'Folder deletion failed' })) as { error?: string };
	      if (!response.ok) {
	        deleteFolderButton.disabled = false;
	        showToast(result.error || 'Folder deletion failed');
	        return;
	      }
	      window.sessionStorage.setItem('imagetourl-pro-flash', `“${name}” deleted. Its images are now Unfiled.`);
	      window.location.reload();
	    });

	    assetForm?.addEventListener('submit', async (event) => {
	      event.preventDefault();
	      const id = assetManageId?.value;
	      const name = assetManageName?.value.trim();
	      if (!id || !name || !assetManageFolder) return;
	      if (assetSubmitButton) assetSubmitButton.disabled = true;
	      const response = await fetch(`/pro/api/assets/${encodeURIComponent(id)}`, {
	        method: 'PATCH',
	        headers: { 'Content-Type': 'application/json' },
	        body: JSON.stringify({ name, folderId: assetManageFolder.value || null })
	      });
	      const result = await response.json().catch(() => ({ error: 'Asset update failed' })) as { error?: string };
	      if (assetSubmitButton) assetSubmitButton.disabled = false;
	      if (!response.ok) {
	        if (response.status === 402) {
	          closeDialog(assetDialog);
	          requestUploadAccess(result.error);
	          return;
	        }
	        showToast(result.error || 'Asset update failed');
	        return;
	      }
	      window.sessionStorage.setItem('imagetourl-pro-flash', `“${name}” updated in your library`);
	      window.location.reload();
	    });

	    workspaceForm?.addEventListener('submit', async (event) => {
	      event.preventDefault();
	      const privateDefault = settingPrivateDefault?.checked === true;
	      const response = await fetch('/pro/api/preferences', {
	        method: 'PUT',
	        headers: { 'Content-Type': 'application/json' },
	        body: JSON.stringify({ privateDefault })
	      });
	      const result = await response.json().catch(() => ({ error: 'Save failed' })) as { error?: string };
	      if (!response.ok) {
	        showToast(result.error || 'Save failed');
	        return;
	      }
	      privatePreference?.setAttribute('aria-pressed', String(privateDefault));
	      closeDialog(workspaceDialog);
	      showToast('Workspace preferences saved');
	    });

      const loadPaddle = async () => {
        const existing = document.querySelector<HTMLScriptElement>('script[data-paddle-js]');
        if ((window as unknown as { Paddle?: unknown }).Paddle) return;
        if (!existing) throw new Error('Paddle checkout is not configured');
        await new Promise<void>((resolve, reject) => {
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error('Paddle.js failed to load')), {
              once: true
          });
        });
      };

      const openBilling = async () => {
        if (!billingActionButton || billingActionButton.disabled) {
          openDialog(workspaceDialog);
          return;
        }
        billingActionButton.disabled = true;
        const originalLabel = billingActionButton.textContent;
        billingActionButton.textContent = 'Opening Paddle…';

        try {
          const manageExisting = billingActionButton.dataset.mode === 'portal';
          if (manageExisting) {
            const response = await fetch('/pro/api/billing/portal', { method: 'POST' });
            const result = await response.json().catch(() => ({ error: 'Billing portal failed' })) as {
              url?: string;
              error?: string;
            };
            if (!response.ok || !result.url) throw new Error(result.error || 'Billing portal failed');
            window.location.assign(result.url);
            return;
          }

          const selectedCheckoutInterval = billingInterval?.value === 'three_year'
            ? 'three_year'
            : billingInterval?.value === 'year'
              ? 'year'
              : 'month';
          const response = await fetch('/pro/api/billing/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              interval: selectedCheckoutInterval,
              interestSessionId: window.sessionStorage.getItem('imagetourl_pro_interest_session')
            })
          });
          const result = await response.json().catch(() => ({ error: 'Checkout failed' })) as {
            transactionId?: string;
            clientToken?: string;
            environment?: 'sandbox' | 'production';
            error?: string;
          };
          if (!response.ok || !result.transactionId || !result.clientToken || !result.environment) {
            throw new Error(result.error || 'Checkout failed');
          }

          await loadPaddle();
          const paddle = (window as unknown as {
            Paddle?: {
              Environment: { set(environment: 'sandbox'): void };
              Initialize(options: {
                token: string;
                eventCallback(event: { name?: string; data?: unknown }): void;
              }): void;
              Checkout: {
                open(options: {
                  transactionId: string;
                  settings: {
                    displayMode: 'overlay';
                    variant: 'one-page';
                    theme: 'light';
                    locale: 'en';
                    successUrl: string;
                  };
                }): void;
              };
            };
          }).Paddle;
          if (!paddle) throw new Error('Paddle.js did not initialize');
          if (result.environment === 'sandbox') paddle.Environment.set('sandbox');
          paddle.Initialize({
            token: result.clientToken,
            eventCallback: (event) => {
              if (event.name === 'checkout.completed') {
                (window as unknown as {
                  trackProPaddlePurchase?: (checkoutEvent: { name?: string; data?: unknown }) => void;
                }).trackProPaddlePurchase?.(event);
                window.sessionStorage.setItem(
                  'imagetourl-pro-flash',
                  'Payment received. Paddle is activating your Pro workspace.'
                );
              }
            }
          });
          (window as unknown as {
            trackProCheckoutStarted?: (transactionId: string, plan: 'month' | 'year' | 'three_year') => void;
          }).trackProCheckoutStarted?.(result.transactionId, selectedCheckoutInterval);
          closeDialog(workspaceDialog);
          paddle.Checkout.open({
            transactionId: result.transactionId,
            settings: {
              displayMode: 'overlay',
              variant: 'one-page',
              theme: 'light',
              locale: 'en',
              successUrl: `${window.location.origin}/pro/workspace?billing=success`
            }
          });
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'Billing could not be opened');
        } finally {
          billingActionButton.disabled = false;
          billingActionButton.textContent = originalLabel;
        }
      };

      if (billingActionButton) {
        billingActionButton.addEventListener('click', openBilling);
      }

	    window.addEventListener('keydown', (event) => {
	      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
	        event.preventDefault();
	        focusAssetSearch();
	      }
	    });
	  </script>
</ProShell>
