---
import ProShell from '../layouts/ProShell.astro';
import { assetUrl, formatBytes, relativeAge } from '../lib/assets';
import {
  isPaddleCheckoutConfigured,
  paddleEnvironment,
} from '../lib/billing';
import { hasProAccess } from '../lib/entitlements';
import { getProEnv } from '../lib/env';
import { proPath } from '../lib/paths';

const user = Astro.locals.proUser!;
const env = getProEnv();
const origin = import.meta.env.DEV
  ? new URL(import.meta.env.BASE_URL, Astro.url.origin).toString()
  : env.SITE_URL;
const periodStart = `${new Date().getUTCFullYear()}-${String(new Date().getUTCMonth() + 1).padStart(2, '0')}-01`;
const initialLibraryLimit = 24;

const [assetResult, folderResult, storageResult, usage, preferences, subscription] = await Promise.all([
  env.PRO_DB.prepare(
    `SELECT id, folder_id, original_name, mime_type, size_bytes, visibility, created_at
      FROM assets
      WHERE user_id = ? AND status = 'ready'
	      ORDER BY created_at DESC, id DESC LIMIT ?`
	).bind(user.id, initialLibraryLimit).all<{
    id: string;
    folder_id: string | null;
    original_name: string;
    mime_type: string;
    size_bytes: number;
    visibility: 'private' | 'unlisted' | 'public';
    created_at: string;
  }>(),
  env.PRO_DB.prepare(
    `SELECT f.id, f.name, COUNT(a.id) AS asset_count
       FROM folders f
       LEFT JOIN assets a ON a.folder_id = f.id AND a.status = 'ready'
      WHERE f.user_id = ?
      GROUP BY f.id, f.name
      ORDER BY f.name COLLATE NOCASE`
  ).bind(user.id).all<{ id: string; name: string; asset_count: number }>(),
  env.PRO_DB.prepare(
	    `SELECT COALESCE(SUM(size_bytes), 0) AS bytes,
	            COUNT(*) AS count,
	            COALESCE(SUM(CASE WHEN folder_id IS NULL THEN 1 ELSE 0 END), 0) AS unfiled_count
       FROM assets WHERE user_id = ? AND status = 'ready'`
	).bind(user.id).first<{ bytes: number; count: number; unfiled_count: number }>(),
  env.PRO_DB.prepare(
    `SELECT bandwidth_bytes, uploads_count, api_requests
       FROM usage_monthly WHERE user_id = ? AND period_start = ?`
  ).bind(user.id, periodStart).first<{
    bandwidth_bytes: number;
    uploads_count: number;
    api_requests: number;
  }>(),
  env.PRO_DB.prepare(
    `SELECT private_default FROM workspace_preferences WHERE user_id = ?`
  ).bind(user.id).first<{ private_default: number }>(),
  env.PRO_DB.prepare(
    `SELECT provider_customer_id, provider_subscription_id, status, price_id,
            current_period_end, cancel_at_period_end
       FROM subscriptions
      WHERE user_id = ?
        AND provider = 'paddle'
        AND paddle_environment = ?
      ORDER BY
        CASE status
          WHEN 'active' THEN 1
          WHEN 'trialing' THEN 2
          WHEN 'past_due' THEN 3
          WHEN 'paused' THEN 4
          ELSE 5
        END,
        updated_at DESC
      LIMIT 1`
  ).bind(user.id, paddleEnvironment(env)).first<{
    provider_customer_id: string | null;
    provider_subscription_id: string | null;
    status: 'incomplete' | 'trialing' | 'active' | 'past_due' | 'paused' | 'canceled';
    price_id: string | null;
    current_period_end: string | null;
    cancel_at_period_end: number;
  }>()
]);

const assets = (assetResult.results ?? []).map((asset) => ({
  id: asset.id,
  folderId: asset.folder_id,
  name: asset.original_name,
  format: asset.mime_type.split('/')[1]?.toUpperCase() || 'IMAGE',
  size: formatBytes(asset.size_bytes),
  age: relativeAge(asset.created_at),
  visibility: asset.visibility,
	  mimeType: asset.mime_type,
	  sizeBytes: asset.size_bytes,
	  createdAt: asset.created_at,
	  url: assetUrl(origin, asset.id, asset.original_name)
}));
const folders = folderResult.results ?? [];
const storageBytes = Number(storageResult?.bytes ?? 0);
const assetTotal = Number(storageResult?.count ?? 0);
const unfiledAssetTotal = Number(storageResult?.unfiled_count ?? 0);
const finalInitialAsset = assets.at(-1);
const initialLibraryCursor = assetTotal > assets.length && finalInitialAsset
	? btoa(JSON.stringify({ createdAt: finalInitialAsset.createdAt, id: finalInitialAsset.id }))
	: '';
const bandwidthBytes = Number(usage?.bandwidth_bytes ?? 0);
const uploadsCount = Number(usage?.uploads_count ?? 0);
const privateDefault = preferences?.private_default === 1;
const firstName = user.name.trim().split(/\s+/)[0] || 'there';
const avatarInitial = firstName.slice(0, 1).toUpperCase();
const checkoutConfigured = isPaddleCheckoutConfigured(env);
const portalConfigured = Boolean(
  env.PADDLE_API_KEY &&
  (env.PADDLE_ENVIRONMENT === 'sandbox' || env.PADDLE_ENVIRONMENT === 'production')
);
const billingStatus = subscription?.status ?? 'preview';
const proAccessEnabled = hasProAccess(subscription?.status);
const hasPaddleCustomer = Boolean(subscription?.provider_customer_id);
const billingActionMode =
  hasPaddleCustomer && subscription?.status !== 'canceled' && subscription?.status !== 'incomplete'
    ? 'portal'
    : 'checkout';
const billingActionAvailable =
  billingActionMode === 'portal' ? portalConfigured : checkoutConfigured;
const billingActionLabel =
  billingActionMode === 'portal'
    ? 'Open secure billing portal'
    : subscription?.status === 'canceled'
      ? 'Restart Pro securely'
      : checkoutConfigured
        ? 'Continue to secure checkout'
        : 'Finish Paddle setup to enable checkout';
const sidebarBillingLabel =
  billingActionMode === 'portal'
    ? 'Manage billing'
    : subscription?.status === 'canceled'
      ? 'Restart Pro'
      : checkoutConfigured
        ? 'Choose Pro plan'
        : 'Paddle setup pending';
const accessNeedsBillingRepair = subscription?.status === 'past_due' || subscription?.status === 'paused';
const storageUsageLabel = proAccessEnabled
  ? 'Unlimited storage'
  : accessNeedsBillingRepair
    ? 'Uploads paused'
    : 'Plan inactive';
const storageAllowanceLabel = proAccessEnabled ? 'Unlimited' : 'No active plan';
const profilePlanLabel = proAccessEnabled
  ? 'Pro workspace'
  : accessNeedsBillingRepair
    ? 'Uploads paused'
    : subscription?.status === 'canceled'
      ? 'Subscription canceled'
      : 'Pro preview';
const accessHeadline = accessNeedsBillingRepair
  ? subscription?.status === 'past_due'
    ? 'Restore uploads by fixing your payment'
    : 'Resume Pro to keep uploading'
  : 'Unlock your permanent image workspace';
const accessCopy = accessNeedsBillingRepair
  ? 'Your existing library stays available. New uploads and URL imports are paused until billing is active again.'
  : 'You can explore the workspace now. An active Pro subscription is required before ImageToURL stores a file or creates a permanent URL.';
const accessActionLabel = accessNeedsBillingRepair ? 'Manage billing' : 'Choose Pro';
const billingStatusLabel = {
  preview: 'Pro preview',
  incomplete: 'Setup incomplete',
  trialing: 'Trial active',
  active: subscription?.cancel_at_period_end ? 'Cancels at period end' : 'Active subscription',
  past_due: 'Payment needs attention',
  paused: 'Subscription paused',
  canceled: 'Subscription canceled'
}[billingStatus];
const billingRenewalLabel = subscription?.current_period_end
  ? new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(
      new Date(subscription.current_period_end)
    )
  : null;
const billingDetailsCopy =
  proAccessEnabled && billingRenewalLabel
    ? subscription?.cancel_at_period_end
      ? `Access remains active through ${billingRenewalLabel}.`
      : `Your current billing period ends ${billingRenewalLabel}.`
    : subscription?.status === 'canceled'
      ? 'Your subscription has ended. Choose monthly, annual, or three-year billing to restart Pro.'
      : accessNeedsBillingRepair
        ? 'Open Paddle to restore billing. Your existing library remains available while uploads are paused.'
        : hasPaddleCustomer
          ? 'Manage payment details, invoices, and cancellation securely in Paddle.'
          : 'Subscribe for $12.99 monthly, $95.88 annually, or $143.64 every three years. Checkout is securely handled by Paddle.';
const logoutUrl = new URL(proPath('/sign-out'), new URL(origin).origin);
---

<ProShell>
  <div
    class:list={['app-shell', { 'is-preview-workspace': !proAccessEnabled }]}
    data-pro-access={String(proAccessEnabled)}
    data-access-status={billingStatus}
  >
    <aside class="sidebar" aria-label="Primary navigation">
      <a class="brand" href={proPath('/workspace')} aria-label="ImageToURL Pro workspace">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">image to url</span>
        <span class="pro-chip">PRO</span>
      </a>

      <p class="nav-label">Your space</p>
      <nav class="primary-nav">
        <a class="nav-item" href={proPath('/workspace')} aria-current="page">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3.5 10.5 12 3l8.5 7.5"/><path d="M5.5 9v11h13V9M9.5 20v-6h5v6"/></svg>
          Workspace
        </a>
        <a class="nav-item" href="#recent" data-pro-event="pro_feature_explored" data-pro-location="workspace-library-nav">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 16 3.4-3.6 2.4 2.4 2.3-2.5L19 16"/><circle cx="8.5" cy="8.5" r="1.2"/></svg>
          Library
        </a>
        <a class="nav-item" href="#folders" data-pro-event="pro_feature_explored" data-pro-location="workspace-folders-nav">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 7.5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>
	          Folders
	          <span class="nav-count" id="folder-count">{folders.length}</span>
        </a>
        <a class="nav-item" href="#usage-heading">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 20V10M12 20V4M19 20v-7"/></svg>
          Analytics
        </a>
        <span class="nav-item nav-item-disabled" aria-disabled="true">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"/></svg>
          API
          <span class="nav-soon">Coming soon</span>
        </span>
        <a class="nav-item" href={proPath('/pricing')}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5.5h10.5L20 11l-9 9-7-7Z"/><circle cx="9" cy="10" r="1.2"/></svg>
          Pricing
        </a>
        {user.role === 'admin' && (
          <a class="nav-item" href={proPath('/admin/interest')}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 19V9M10 19V5M16 19v-7M22 19V3"/></svg>
            Interest tracker
          </a>
        )}
      </nav>

      <div class="nav-spacer"></div>

      <a class="nav-item" href="#workspace-settings">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.8 1.8 0 0 0 .36 2l.05.05-2.76 2.76-.05-.05a1.8 1.8 0 0 0-2-.36 1.8 1.8 0 0 0-1.1 1.65V21H10v-.07A1.8 1.8 0 0 0 8.9 19.3a1.8 1.8 0 0 0-2 .36l-.05.05-2.76-2.76.05-.05a1.8 1.8 0 0 0 .36-2A1.8 1.8 0 0 0 2.85 13.8H2v-3.9h.85A1.8 1.8 0 0 0 4.5 8.8a1.8 1.8 0 0 0-.36-2l-.05-.05 2.76-2.76.05.05a1.8 1.8 0 0 0 2 .36A1.8 1.8 0 0 0 10 2.75V2h3.9v.75A1.8 1.8 0 0 0 15 4.4a1.8 1.8 0 0 0 2-.36l.05-.05 2.76 2.76-.05.05a1.8 1.8 0 0 0-.36 2 1.8 1.8 0 0 0 1.65 1.1H22v3.9h-.95A1.8 1.8 0 0 0 19.4 15Z"/></svg>
        Settings
      </a>
      <a class="nav-item nav-signout" href={logoutUrl.toString()}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"/></svg>
        Sign out
      </a>

	      <div class="plan-card">
	        <div class="plan-top">
	          <span>{billingStatusLabel}</span>
	          <span>{storageUsageLabel}</span>
	        </div>
	        <div class="plan-copy">
	          <span>{formatBytes(storageBytes)} used</span>
	          <span>{storageAllowanceLabel}</span>
	        </div>
          <button class="plan-action" id="sidebar-billing-button" type="button">
            {sidebarBillingLabel}
          </button>
	      </div>

	      <div class="profile">
	        {user.avatarUrl
	          ? <img class="avatar avatar-image" src={user.avatarUrl} alt="" referrerpolicy="no-referrer" />
	          : <span class="avatar" aria-hidden="true">{avatarInitial}</span>}
	        <span class="profile-copy">
	          <strong>{user.name}</strong>
	          <span>{profilePlanLabel}</span>
	        </span>
	      </div>
    </aside>

    <main class="main">
      <header class="mobile-topbar">
        <a class="brand" href={proPath('/workspace')} aria-label="ImageToURL Pro workspace">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">image to url</span>
          <span class="pro-chip">PRO</span>
        </a>
        <span class="mobile-account-actions">
          <a class="mobile-signout" href={logoutUrl.toString()} aria-label="Sign out">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"/></svg>
          </a>
          <button class="mobile-profile" id="profile-button" type="button" aria-label="Open workspace settings">{avatarInitial}</button>
        </span>
      </header>

      <header class="content-head" id="workspace-top">
        <div>
          <p class="eyebrow" id="current-date">Your workspace</p>
	          <h1><span id="greeting">Good evening</span>, {firstName}.</h1>
        </div>
        <div class="content-actions">
          <button class="command-search" type="button" aria-label="Search workspace">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
            <span>Search</span>
            <kbd>⌘ K</kbd>
          </button>
          <button class="button button-secondary" id="new-folder-button" type="button">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 7.5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M12 11v5M9.5 13.5h5"/></svg>
            New folder
          </button>
          <button
            class="button button-primary"
            id="upload-button"
            type="button"
            aria-describedby={!proAccessEnabled ? 'upload-access-copy' : undefined}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 16V4M7.5 8.5 12 4l4.5 4.5"/><path d="M5 14v5h14v-5"/></svg>
            Upload images
          </button>
        </div>
      </header>

      <div class="workspace">
        <section class="upload-panel reveal reveal-one" aria-labelledby="upload-heading">
          <div class="upload-layout">
            <div class="upload-intro">
              <div>
                <span class="section-kicker">Pro upload studio</span>
                <h2 class="upload-title" id="upload-heading">Drop it.<em>Keep it.</em></h2>
              </div>
              <div>
                <p>Permanent URLs, untouched quality, and every asset exactly where you expect it.</p>
                <ul class="upload-benefits" aria-label="Pro upload benefits">
                  <li>Permanent</li>
                  <li>Original quality</li>
                  <li>Global delivery</li>
                </ul>
              </div>
            </div>

            <div class="upload-studio">
              {!proAccessEnabled && (
                <section class="upload-access" aria-labelledby="upload-access-heading" data-pro-impression="workspace-paywall" data-pro-impression-event="pro_paywall_viewed">
                  <span class="upload-access-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <rect x="5" y="10" width="14" height="10" rx="3"></rect>
                      <path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10"></path>
                    </svg>
                  </span>
                  <span class="upload-access-copy">
                    <small>{billingStatusLabel}</small>
                    <strong id="upload-access-heading">{accessHeadline}</strong>
                    <span id="upload-access-copy">{accessCopy}</span>
                  </span>
                  <span class="upload-access-actions">
                    <button class="upload-access-action" id="upload-access-action" type="button" data-pro-event="pro_paywall_clicked" data-pro-location="workspace-upload-paywall">
                      {accessActionLabel}
                    </button>
                    <a class="upload-access-free" href="https://imagetourl.cloud/">
                      Use the free version <span aria-hidden="true">↗</span>
                    </a>
                  </span>
                </section>
              )}

              <div class="source-tabs" role="tablist" aria-label="Choose upload source">
                <button type="button" role="tab" aria-selected="true" aria-controls="file-source" id="file-tab">Files</button>
                <button type="button" role="tab" aria-selected="false" aria-controls="url-source" id="url-tab">From URL</button>
              </div>

              <div id="file-source" role="tabpanel" aria-labelledby="file-tab">
                <label
                  class:list={['dropzone', { 'is-locked': !proAccessEnabled }]}
                  id="dropzone"
                  tabindex="0"
                  aria-disabled={!proAccessEnabled}
                >
	                  <input class="sr-only" id="file-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/avif" multiple disabled={!proAccessEnabled} />
                  <span>
                    <span class="drop-icon">
                      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 16V4M7.5 8.5 12 4l4.5 4.5"/><path d="M5 14v5h14v-5"/></svg>
                    </span>
                    <strong>
                      <span class="drop-copy-desktop">Drag your images here</span>
                      <span class="drop-copy-mobile">Tap to choose images</span>
                    </strong>
	                    <small>JPG, PNG, GIF, WebP, AVIF · up to 64 MB</small>
                    <span class="browse-link">{proAccessEnabled ? 'Choose files' : 'Unlock uploads'}</span>
                    <span class="file-feedback" id="file-feedback" aria-live="polite"></span>
                  </span>
                </label>
              </div>

              <div class="url-source" id="url-source" role="tabpanel" aria-labelledby="url-tab" hidden>
                <span class="url-orbit" aria-hidden="true">↗</span>
                <strong>Bring an image from anywhere</strong>
	                <p>Paste a public direct image URL up to 10 MB. Pro will preserve the original in your library.</p>
                <form class="url-form" id="url-form">
                  <label class="sr-only" for="source-url">Image URL</label>
                  <input id="source-url" type="url" placeholder="https://example.com/image.jpg" required disabled={!proAccessEnabled} />
	                  <button type="submit" disabled={!proAccessEnabled}>{proAccessEnabled ? 'Import' : 'Unlock Pro'}</button>
	                </form>
	                <div class="url-preview" id="url-preview" hidden>
	                  <img id="url-preview-image" alt="" />
	                  <span><strong>Importing image</strong><small>Securing a permanent Pro copy…</small></span>
	                </div>
	              </div>

	              <div class="upload-preferences" aria-label="Upload preferences">
	                <button class="preference" type="button" aria-pressed="true" disabled>
	                  <span class="preference-check" aria-hidden="true">✓</span>
	                  Original preserved
	                </button>
	                <button class="preference" type="button" aria-pressed={privateDefault} data-preference="private" disabled={!proAccessEnabled}>
	                  <span class="preference-check" aria-hidden="true">✓</span>
	                  Private link
	                </button>
	                <select class="folder-select" id="upload-folder" aria-label="Upload folder" disabled={!proAccessEnabled}>
	                  <option value="">No folder</option>
	                  {folders.map((folder) => <option value={folder.id}>{folder.name}</option>)}
	                </select>
	              </div>
            </div>
          </div>
        </section>

        <aside class="stats-panel reveal reveal-two" aria-labelledby="usage-heading">
          <header class="summary-head">
            <h2 id="usage-heading">This month</h2>
            <span class="period" id="current-period">Jul 1-31</span>
          </header>

	          <div class="stat">
	            <div class="stat-label"><span>Storage</span><span>{storageAllowanceLabel}</span></div>
	            <div class="summary-value">{formatBytes(storageBytes)}</div>
	          </div>
	          <div class="stat">
	            <div class="stat-label"><span>Bandwidth</span><span>Measured this month</span></div>
	            <div class="summary-value">{formatBytes(bandwidthBytes)}</div>
	            <div class="thin-meter" aria-hidden="true"><span style="width:0%"></span></div>
	          </div>
	          <div class="stat">
	            <div class="stat-label"><span>Uploads</span><span>Across {folders.length} folders</span></div>
	            <div class="summary-value">{uploadsCount.toLocaleString()}</div>
	            <div class="thin-meter" aria-hidden="true"><span style={`width:${Math.min(100, uploadsCount)}%`}></span></div>
	          </div>
	          <p class="summary-note" id="usage-reset-note">
              {proAccessEnabled
                ? 'Usage resets monthly. Your files remain available.'
                : 'Your existing files remain available. Restart Pro to upload again.'}
            </p>
        </aside>

        <section class="toolkit reveal reveal-three" id="toolkit" aria-labelledby="toolkit-heading">
          <header class="toolkit-head">
            <div>
              <p class="micro-label">Built into Pro</p>
              <h2 id="toolkit-heading">Your delivery layer, already configured.</h2>
            </div>
            <button class="text-button" id="manage-workspace-button" type="button">Manage workspace <span aria-hidden="true">↗</span></button>
          </header>

          <div class="toolkit-grid">
            <article class="tool-card tool-card-domain">
              <span class="tool-icon">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="8.5"/><path d="M3.8 9h16.4M3.8 15h16.4M12 3.5c2 2.3 3 5.1 3 8.5s-1 6.2-3 8.5c-2-2.3-3-5.1-3-8.5s1-6.2 3-8.5Z"/></svg>
              </span>
	              <span class:list={['status-dot', { 'status-neutral': !proAccessEnabled }]}>
                  {proAccessEnabled ? 'Active' : 'Preview'}
                </span>
	              <h3>Secure delivery</h3>
	              <p>Every asset gets a stable HTTPS URL on the Pro edge.</p>
	              <code id="custom-domain-display">imagetourl.cloud/pro/files</code>
            </article>

            <article class="tool-card" id="smart-delivery">
              <span class="tool-icon">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m13 2-8 12h6l-1 8 9-13h-6Z"/></svg>
              </span>
	              <span class:list={['status-dot', { 'status-neutral': !proAccessEnabled }]}>
                  {proAccessEnabled ? 'Active' : 'Preview'}
                </span>
	              <h3>Original delivery</h3>
	              <p>Files stream directly from dedicated Pro object storage.</p>
	              <span class="tool-metric">Stable URLs with same-link replacement</span>
            </article>

	            <article class="tool-card" id="smart-library">
              <span class="tool-icon">
	                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 7.5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="m9 14 2 2 4-4"/></svg>
              </span>
	              <span class:list={['status-dot', { 'status-neutral': !proAccessEnabled }]}>
                  {proAccessEnabled ? 'Active' : 'Preview'}
                </span>
	              <h3>Smart library</h3>
