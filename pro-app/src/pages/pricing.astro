---
export const prerender = false;

import ProMarketingShell from '../layouts/ProMarketingShell.astro';
import {
  isPaddleCheckoutConfigured,
  paddleEnvironment,
} from '../lib/billing';
import { getProEnv } from '../lib/env';
import { proAbsoluteUrl, proPath } from '../lib/paths';

const env = getProEnv();
const user = Astro.locals.proUser;
const requestedInterval = Astro.url.searchParams.get('billing');
const initialInterval = requestedInterval === 'month' || requestedInterval === 'year'
  ? requestedInterval
  : 'three_year';
const checkoutConfigured = isPaddleCheckoutConfigured(env);
const paddleToken = env.PADDLE_CLIENT_TOKEN ?? '';
const paddleEnv = paddleEnvironment(env);
const initialCheckoutPrice = initialInterval === 'three_year'
  ? '$143.64/3 years'
  : initialInterval === 'year'
    ? '$95.88/year'
    : '$12.99/month';

let hasSubscription = false;
if (user) {
  const subscription = await env.PRO_DB.prepare(
    `SELECT id
       FROM subscriptions
      WHERE user_id = ?
        AND provider = 'paddle'
        AND paddle_environment = ?
        AND status IN ('trialing', 'active', 'past_due', 'paused')
      LIMIT 1`,
  )
    .bind(user.id, paddleEnvironment(env))
    .first();
  hasSubscription = Boolean(subscription);
}

const returnTo = `${proAbsoluteUrl('/pricing')}?billing=${initialInterval}`;
const loginUrl = new URL(proPath('/sign-in'), new URL(env.SITE_URL).origin);
loginUrl.searchParams.set('return_to', returnTo);
const pricingUrl = proAbsoluteUrl('/pricing');
const workspaceUrl = proPath('/workspace');
const checkoutApiUrl = proPath('/api/billing/checkout');
---

<ProMarketingShell
  title="ImageToURL Pro Pricing — Monthly, Annual & 3-Year Plans"
  description="Get unlimited image storage, permanent image URLs, private assets, folders, URL imports, and usage analytics with ImageToURL Pro."
>
  <main class="marketing-main pricing-main">
    <section class="pricing-hero">
      <div class="pricing-hero-copy">
        <p class="marketing-kicker">Founding pricing · no hidden overages</p>
        <h1>Simple pricing for image links your work <em>depends on.</em></h1>
        <p>
          One professional workspace with permanent URLs, original-quality storage, and no surprise
          usage bill. Choose how you want to pay.
        </p>
      </div>
      <ul class="pricing-proof-strip" aria-label="Plan highlights">
        <li><strong>Unlimited</strong><span>image storage</span></li>
        <li><strong>1M</strong><span>image views monthly</span></li>
        <li><strong>64MB</strong><span>maximum file size</span></li>
      </ul>
    </section>

    <section class="pro-plan-wrap" aria-label="ImageToURL Pro founding plan">
      <article class="pro-plan-card">
        <header class="pro-plan-heading">
          <span class="pro-plan-badge">Founding price</span>
          <h2>ImageToURL Pro</h2>
          <p>Your price stays locked while your subscription remains active.</p>
        </header>

        <div class="pro-billing-choice" role="group" aria-label="Choose your billing frequency">
          <button type="button" data-interval="month" data-pro-event="pro_plan_selected" data-pro-location="pro-pricing-toggle" data-pro-plan="month" aria-pressed={initialInterval === 'month'}>
            <span>
              <strong>Monthly</strong>
              <small>Pay month to month</small>
            </span>
            <b>$12.99 <small>/ month</small></b>
          </button>
          <button type="button" data-interval="year" data-pro-event="pro_plan_selected" data-pro-location="pro-pricing-toggle" data-pro-plan="year" aria-pressed={initialInterval === 'year'}>
            <span>
              <strong>Annual</strong>
              <small>Save 38% vs monthly</small>
            </span>
            <b>$95.88 <small>/ year</small></b>
          </button>
          <button type="button" data-interval="three_year" data-pro-event="pro_plan_selected" data-pro-location="pro-pricing-toggle" data-pro-plan="three_year" aria-pressed={initialInterval === 'three_year'}>
            <span>
              <strong>3-Year</strong>
              <small>Best value · save 69%</small>
            </span>
            <b>$143.64 <small>/ 3 years</small></b>
          </button>
        </div>

        <div class="pro-price-row">
          <strong id="display-price">{initialInterval === 'three_year' ? '$143.64' : initialInterval === 'year' ? '$95.88' : '$12.99'}</strong>
          <span id="display-period">{initialInterval === 'three_year' ? 'per 3 years' : initialInterval === 'year' ? 'per year' : 'per month'}</span>
        </div>
        <p class="pro-price-note" id="display-note">
          {initialInterval === 'three_year'
            ? '$3.99/month equivalent, billed $143.64 every 3 years'
            : initialInterval === 'year'
              ? '$7.99/month equivalent, billed annually'
              : 'Billed monthly. Cancel before renewal.'}
        </p>

        {hasSubscription ? (
          <a class="pro-checkout-button" href={proPath('/workspace')}>
            <span>Open your Pro workspace</span><span aria-hidden="true">↗</span>
          </a>
        ) : user ? (
          <button
            class="pro-checkout-button"
            id="checkout-button"
            type="button"
            data-interval={initialInterval}
            data-pro-event="pro_plan_selected"
            data-pro-location="pro-pricing-checkout"
            data-pro-plan={initialInterval}
            disabled={!checkoutConfigured}
          >
            <span id="checkout-label">
              {checkoutConfigured
                ? `Continue with Pro — ${initialCheckoutPrice}`
                : 'Checkout setup in progress'}
            </span>
            <span aria-hidden="true">↗</span>
          </button>
        ) : (
          <a class="pro-checkout-button" id="signin-checkout" href={loginUrl.toString()} data-pro-event="pro_plan_selected" data-pro-location="pro-pricing-signin" data-pro-plan={initialInterval}>
            <span id="signin-label">
              Sign in to continue — {initialCheckoutPrice}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
        <p class="pro-checkout-error" id="checkout-error" role="alert"></p>
        <div class="pro-checkout-assurance" aria-label="Purchase assurances">
          <span>Paddle secure checkout</span>
          <span>Cancel online</span>
          <span>14-day refund policy</span>
        </div>
        {!hasSubscription && (
          <a class="pro-continue-free" href="https://imagetourl.cloud">Not ready? Continue with free ImageToURL</a>
        )}
      </article>

      <aside class="pro-feature-panel">
        <p>Included with your subscription</p>
        <ul class="pro-feature-list">
          <li>Unlimited active image storage</li>
          <li>Up to 1 million image views each month</li>
          <li>64MB maximum file size</li>
          <li>Replace an image without changing its URL</li>
          <li>Permanent HTTPS delivery URLs</li>
          <li>Original-quality image storage</li>
          <li>Public, unlisted, and private assets</li>
          <li>Folders and import from URL</li>
          <li>Workspace usage analytics</li>
          <li>Private, focused Pro workspace</li>
          <li>Production API access when released</li>
        </ul>
      </aside>
    </section>

    <section class="pricing-facts" aria-label="Subscription benefits">
      <article>
        <span>01 / STORAGE</span>
        <h3>No storage cap</h3>
        <p>Store unlimited images without a capacity meter or storage-overage charge.</p>
      </article>
      <article>
        <span>02 / CONTROL</span>
        <h3>Cancel online</h3>
        <p>Use the secure Paddle portal for cancellation, payment details, invoices, and receipts.</p>
      </article>
      <article>
        <span>03 / CONFIDENCE</span>
        <h3>14-day first-purchase refund</h3>
        <p>Try the real workspace. If it is not a fit, request your first payment back within 14 days.</p>
      </article>
    </section>

    <section class="pricing-faq">
      <header>
        <p class="marketing-kicker">Before you subscribe</p>
        <h2>Clear answers, before checkout.</h2>
      </header>
      <div class="pricing-faq-list">
        <details open>
          <summary>What exactly am I purchasing?</summary>
          <p>
            A recurring ImageToURL Pro subscription for one personal workspace with unlimited image
            storage and the features shown above. The API is marked for future release and is not production-ready today.
          </p>
        </details>
        <details>
          <summary>Is Pro storage really unlimited?</summary>
          <p>
            Yes. Active Pro workspaces have no fixed storage-capacity limit or storage-overage charge.
            The 64MB per-file limit, upload-rate protection, monthly delivery allowance, and Acceptable Use Policy still apply.
          </p>
        </details>
        <details>
          <summary>Does the subscription renew automatically?</summary>
          <p>
            Yes. Monthly plans renew monthly, annual plans renew annually, and three-year plans renew every
            three years until you cancel before the renewal date. Paddle shows the total, tax, and renewal details at checkout.
          </p>
        </details>
        <details>
          <summary>What happens if I cancel?</summary>
          <p>
            Cancellation stops future renewal. Paid access normally continues until the end of the
            current billing period. Download important files before paid access ends.
          </p>
        </details>
        <details>
          <summary>Who handles payment and tax?</summary>
          <p>
            Paddle is the Merchant of Record and securely handles checkout, applicable tax or VAT,
            receipts, invoices, and buyer payment support. ImageToURL does not store your full card number.
          </p>
        </details>
        <details>
          <summary>Can I get a refund?</summary>
          <p>
            Your first subscription payment is covered by our 14-day refund policy, subject to the fair-use
            conditions in the <a href={proPath('/refund-policy')}>Refund Policy</a> and any stronger rights under law.
          </p>
        </details>
      </div>
    </section>

    <section class="pricing-disclosure">
      <p>
        Prices are USD. Applicable taxes are calculated at checkout. By subscribing, you agree to the
        <a href={proPath('/terms')}>Terms of Service</a>, <a href={proPath('/privacy')}>Privacy Policy</a>,
        <a href={proPath('/refund-policy')}>Refund Policy</a>, and <a href={proPath('/acceptable-use-policy')}>Acceptable Use Policy</a>.
      </p>
      <p>ImageToURL is operated by Bipul Kumar. Paddle acts as Merchant of Record for Pro purchases.</p>
    </section>
  </main>

  {paddleToken && <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js" data-paddle-js></script>}

  <script
    is:inline
    define:vars={{
      initialInterval,
      paddleToken,
      paddleEnv,
      checkoutConfigured,
      loginUrl: loginUrl.toString(),
      isAuthenticated: Boolean(user),
      pricingUrl,
      workspaceUrl,
      checkoutApiUrl,
    }}
  >
    const intervalButtons = Array.from(document.querySelectorAll('.pro-billing-choice [data-interval]'));
    const displayPrice = document.querySelector('#display-price');
    const displayPeriod = document.querySelector('#display-period');
    const displayNote = document.querySelector('#display-note');
    const checkoutButton = document.querySelector('#checkout-button');
    const checkoutLabel = document.querySelector('#checkout-label');
    const signinCheckout = document.querySelector('#signin-checkout');
    const signinLabel = document.querySelector('#signin-label');
    const errorBox = document.querySelector('#checkout-error');
    let selectedInterval = initialInterval;
    let paddleInitialized = false;

    const planCopy = {
      month: {
        price: '$12.99',
        period: 'per month',
        note: 'Billed monthly. Cancel before renewal.',
      },
      year: {
        price: '$95.88',
        period: 'per year',
        note: '$7.99/month equivalent, billed annually',
      },
      three_year: {
        price: '$143.64',
        period: 'per 3 years',
        note: '$3.99/month equivalent, billed every 3 years',
      },
    };

    const getActionCopy = () => {
      const total = selectedInterval === 'three_year'
        ? '$143.64/3 years'
        : selectedInterval === 'year'
          ? '$95.88/year'
          : '$12.99/month';
      return {
        checkout: `Continue with Pro — ${total}`,
        signin: `Sign in to continue — ${total}`,
      };
    };

    const setInterval = (interval) => {
      selectedInterval = interval === 'month' || interval === 'three_year' ? interval : 'year';
      const copy = planCopy[selectedInterval];
      const actionCopy = getActionCopy();
      if (displayPrice) displayPrice.textContent = copy.price;
      if (displayPeriod) displayPeriod.textContent = copy.period;
      if (displayNote) displayNote.textContent = copy.note;
      if (checkoutButton) {
        checkoutButton.dataset.interval = selectedInterval;
        checkoutButton.dataset.proPlan = selectedInterval;
      }
      if (checkoutLabel) checkoutLabel.textContent = actionCopy.checkout;
      if (signinLabel) signinLabel.textContent = actionCopy.signin;
      if (signinCheckout) {
        signinCheckout.dataset.proPlan = selectedInterval;
        const target = new URL(loginUrl);
        target.searchParams.set(
          'return_to',
          `${pricingUrl}?billing=${selectedInterval}`,
        );
        signinCheckout.href = target.toString();
      }
      intervalButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.interval === selectedInterval));
      });
      const pageUrl = new URL(window.location.href);
      pageUrl.searchParams.set('billing', selectedInterval);
      window.history.replaceState({}, '', pageUrl);
    };

    intervalButtons.forEach((button) => {
      button.addEventListener('click', () => setInterval(button.dataset.interval));
    });
    const initializePaddle = () => {
      if (paddleInitialized || !paddleToken || !window.Paddle) return Boolean(window.Paddle);
      if (paddleEnv === 'sandbox') window.Paddle.Environment.set('sandbox');
      window.Paddle.Initialize({
        token: paddleToken,
        eventCallback(event) {
          if (event && event.name === 'checkout.completed') {
            window.trackProPaddlePurchase?.(event);
            window.sessionStorage.setItem(
              'imagetourl-pro-flash',
              'Payment received. Paddle is activating your Pro workspace.',
            );
            window.location.assign(`${workspaceUrl}?billing=success`);
          }
        },
      });
      paddleInitialized = true;
      return true;
    };

    initializePaddle();

    checkoutButton?.addEventListener('click', async () => {
      if (!checkoutConfigured || !isAuthenticated) return;
      checkoutButton.disabled = true;
      const previousLabel = checkoutLabel?.textContent;
      if (checkoutLabel) checkoutLabel.textContent = 'Opening secure checkout…';
      if (errorBox) errorBox.textContent = '';

      try {
        const response = await fetch(checkoutApiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            interval: selectedInterval,
            interestSessionId: window.sessionStorage.getItem('imagetourl_pro_interest_session'),
          }),
        });
        const result = await response.json().catch(() => ({ error: 'Checkout failed' }));
        if (!response.ok || !result.transactionId) {
          throw new Error(result.error || 'Checkout could not be started.');
        }
        window.trackProCheckoutStarted?.(result.transactionId, selectedInterval);
        if (!initializePaddle()) throw new Error('Secure checkout could not be loaded.');
        window.Paddle.Checkout.open({
          transactionId: result.transactionId,
          settings: {
            displayMode: 'overlay',
            variant: 'one-page',
            theme: 'light',
            locale: 'en',
            successUrl: new URL(`${workspaceUrl}?billing=success`, window.location.origin).toString(),
          },
        });
      } catch (error) {
        if (errorBox) {
          errorBox.textContent = error instanceof Error ? error.message : 'Checkout could not be started.';
        }
      } finally {
        checkoutButton.disabled = false;
        if (checkoutLabel) checkoutLabel.textContent = previousLabel || getActionCopy().checkout;
      }
    });
  </script>
</ProMarketingShell>
