  </div>

    {checkoutConfigured && (
      <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js" data-paddle-js></script>
    )}

	  <script>
	    const input = document.querySelector<HTMLInputElement>('#file-input');
	    const dropzone = document.querySelector<HTMLElement>('#dropzone');
	    const feedback = document.querySelector<HTMLElement>('#file-feedback');
	    const uploadButton = document.querySelector<HTMLButtonElement>('#upload-button');
	    const emptyUploadButton = document.querySelector<HTMLButtonElement>('#empty-upload-button');
	    const dateLabel = document.querySelector<HTMLElement>('#current-date');
	    const greeting = document.querySelector<HTMLElement>('#greeting');
	    const currentPeriod = document.querySelector<HTMLElement>('#current-period');
	    const grid = document.querySelector<HTMLElement>('#asset-grid');
	    const gridButton = document.querySelector<HTMLButtonElement>('#grid-view');
	    const listButton = document.querySelector<HTMLButtonElement>('#list-view');
	    const fileTab = document.querySelector<HTMLButtonElement>('#file-tab');
	    const urlTab = document.querySelector<HTMLButtonElement>('#url-tab');
	    const fileSource = document.querySelector<HTMLElement>('#file-source');
	    const urlSource = document.querySelector<HTMLElement>('#url-source');
	    const urlForm = document.querySelector<HTMLFormElement>('#url-form');
	    const urlInput = document.querySelector<HTMLInputElement>('#source-url');
	    const urlPreview = document.querySelector<HTMLElement>('#url-preview');
	    const urlPreviewImage = document.querySelector<HTMLImageElement>('#url-preview-image');
	    const searchInput = document.querySelector<HTMLInputElement>('#asset-search');
	    const assetCards = document.querySelectorAll<HTMLElement>('.asset-card');
	    const toast = document.querySelector<HTMLElement>('#toast');
	    const toastMessage = document.querySelector<HTMLElement>('#toast-message');
	    const commandSearch = document.querySelector<HTMLButtonElement>('.command-search');
	    const folderDialog = document.querySelector<HTMLDialogElement>('#folder-dialog');
	    const folderForm = document.querySelector<HTMLFormElement>('#folder-form');
	    const folderName = document.querySelector<HTMLInputElement>('#folder-name');
	    const workspaceDialog = document.querySelector<HTMLDialogElement>('#workspace-dialog');
	    const workspaceForm = document.querySelector<HTMLFormElement>('#workspace-form');
	    const newFolderButton = document.querySelector<HTMLButtonElement>('#new-folder-button');
	    const manageWorkspaceButton = document.querySelector<HTMLButtonElement>('#manage-workspace-button');
	    const profileButton = document.querySelector<HTMLButtonElement>('#profile-button');
      const sidebarBillingButton = document.querySelector<HTMLButtonElement>('#sidebar-billing-button');
      const billingActionButton = document.querySelector<HTMLButtonElement>('#billing-action-button');
      const billingInterval = document.querySelector('#billing-interval') as
        | (Element & { value: string })
        | null;
      const storagePackSelect = document.querySelector('#storage-pack-quantity') as
        | (Element & { value: string })
        | null;
      const storageAddonPreview = document.querySelector<HTMLButtonElement>('#storage-addon-preview');
      const storageAddonConfirm = document.querySelector<HTMLElement>('#storage-addon-confirm');
      const storageAddonPreviewCopy = document.querySelector<HTMLElement>('#storage-addon-preview-copy');
      const storageAddonBack = document.querySelector<HTMLButtonElement>('#storage-addon-back');
      const storageAddonApply = document.querySelector<HTMLButtonElement>('#storage-addon-apply');
      const storageAddonFeedback = document.querySelector<HTMLElement>('#storage-addon-feedback');
	    const settingPrivateDefault = document.querySelector<HTMLInputElement>('#setting-private-default');
	    const privatePreference = document.querySelector<HTMLButtonElement>('[data-preference="private"]');
	    const uploadFolder = document.querySelector('#upload-folder') as (Element & { value: string }) | null;
      const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a');
	    let toastTimer: number | undefined;

	    const showToast = (message: string) => {
	      if (!toast || !toastMessage) return;
	      window.clearTimeout(toastTimer);
	      toastMessage.textContent = message;
	      toast.classList.add('is-visible');
	      toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 3200);
	    };

	    {
	      const now = new Date();
	      const hour = now.getHours();
	      const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
	      const month = new Intl.DateTimeFormat('en', { month: 'short' }).format(now);
	      if (greeting) {
	        greeting.textContent = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
	      }
	      if (currentPeriod) currentPeriod.textContent = `${month} 1-${lastDay}`;
	      if (dateLabel) {
	        dateLabel.textContent = new Intl.DateTimeFormat('en', {
	          weekday: 'long',
	          month: 'short',
	          day: 'numeric'
	        }).format(now);
	      }
	      const flash = window.sessionStorage.getItem('imagetourl-pro-flash');
	      if (flash) {
	        window.sessionStorage.removeItem('imagetourl-pro-flash');
	        window.setTimeout(() => showToast(flash), 120);
	      }
        const billingResult = new URLSearchParams(window.location.search).get('billing');
        if (billingResult === 'success') {
          window.history.replaceState({}, '', window.location.pathname);
          window.setTimeout(
            () => showToast('Payment received. Paddle is activating your Pro workspace.'),
            120
          );
        }
	    }

	    const isPrivate = () => privatePreference?.getAttribute('aria-pressed') === 'true';

	    const uploadFiles = async (files: FileList | null) => {
	      if (!files?.length || !feedback) return;
	      const queue = Array.from(files).slice(0, 20);
	      feedback.classList.add('is-visible');

	      for (let index = 0; index < queue.length; index += 1) {
	        const file = queue[index];
	        feedback.textContent = `Uploading ${index + 1} of ${queue.length} · ${file.name}`;
	        const form = new FormData();
	        form.set('file', file);
	        form.set('visibility', isPrivate() ? 'private' : 'unlisted');
	        if (uploadFolder?.value) form.set('folderId', uploadFolder.value);

	        const response = await fetch('/api/upload', { method: 'POST', body: form });
	        const result = await response.json().catch(() => ({ error: 'Upload failed' })) as { error?: string };
	        if (!response.ok) {
	          feedback.textContent = result.error || 'Upload failed';
	          showToast(result.error || 'Upload failed');
	          return;
	        }
	      }

	      window.sessionStorage.setItem(
	        'imagetourl-pro-flash',
	        queue.length === 1 ? 'Image uploaded to your Pro library' : `${queue.length} images uploaded`
	      );
	      window.location.reload();
	    };

	    const setSource = (source: 'file' | 'url') => {
	      const isFile = source === 'file';
	      fileTab?.setAttribute('aria-selected', String(isFile));
	      urlTab?.setAttribute('aria-selected', String(!isFile));
	      if (fileSource) fileSource.hidden = !isFile;
	      if (urlSource) urlSource.hidden = isFile;
	    };

	    const openDialog = (dialog: HTMLDialogElement | null) => {
	      if (!dialog || dialog.open) return;
	      dialog.showModal();
	    };

	    const closeDialog = (dialog: HTMLDialogElement | null) => {
	      if (dialog?.open) dialog.close();
	    };

	    input?.addEventListener('change', () => uploadFiles(input.files));
	    uploadButton?.addEventListener('click', () => input?.click());
	    emptyUploadButton?.addEventListener('click', () => input?.click());
	    fileTab?.addEventListener('click', () => setSource('file'));
	    urlTab?.addEventListener('click', () => {
	      setSource('url');
	      window.setTimeout(() => urlInput?.focus(), 50);
	    });
	    dropzone?.addEventListener('keydown', (event) => {
	      if (event.key === 'Enter' || event.key === ' ') {
	        event.preventDefault();
	        input?.click();
	      }
	    });
	    dropzone?.addEventListener('dragover', (event) => {
	      event.preventDefault();
	      dropzone.classList.add('is-dragging');
	    });
	    dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('is-dragging'));
	    dropzone?.addEventListener('drop', (event) => {
	      event.preventDefault();
	      dropzone.classList.remove('is-dragging');
	      uploadFiles(event.dataTransfer?.files ?? null);
	    });

	    privatePreference?.addEventListener('click', () => {
	      const enabled = privatePreference.getAttribute('aria-pressed') !== 'true';
	      privatePreference.setAttribute('aria-pressed', String(enabled));
	      if (settingPrivateDefault) settingPrivateDefault.checked = enabled;
	    });

	    urlForm?.addEventListener('submit', async (event) => {
	      event.preventDefault();
	      if (!urlInput?.value || !urlPreview || !urlPreviewImage) return;
	      urlPreviewImage.src = urlInput.value;
	      urlPreview.hidden = false;
	      const response = await fetch('/api/import', {
	        method: 'POST',
	        headers: { 'Content-Type': 'application/json' },
	        body: JSON.stringify({
	          url: urlInput.value,
	          visibility: isPrivate() ? 'private' : 'unlisted',
	          folderId: uploadFolder?.value || null
	        })
	      });
	      const result = await response.json().catch(() => ({ error: 'Import failed' })) as { error?: string };
	      if (!response.ok) {
	        urlPreview.hidden = true;
	        showToast(result.error || 'Import failed');
	        return;
	      }
	      window.sessionStorage.setItem('imagetourl-pro-flash', 'Image imported to your Pro library');
	      window.location.reload();
	    });

	    const setView = (list: boolean) => {
	      grid?.classList.toggle('is-list', list);
	      gridButton?.setAttribute('aria-pressed', String(!list));
	      listButton?.setAttribute('aria-pressed', String(list));
	    };
	    gridButton?.addEventListener('click', () => setView(false));
	    listButton?.addEventListener('click', () => setView(true));

	    searchInput?.addEventListener('input', () => {
	      const query = searchInput.value.trim().toLowerCase();
	      assetCards.forEach((card) => {
	        card.hidden = Boolean(query) && !card.dataset.assetName?.includes(query);
	      });
	    });

	    document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((button) => {
	      button.addEventListener('click', async () => {
	        const url = button.dataset.copyUrl;
	        if (!url) return;
	        await navigator.clipboard.writeText(url);
	        button.classList.add('is-copied');
	        button.textContent = '✓ Copied';
	        showToast('Direct URL copied to clipboard');
	        window.setTimeout(() => {
	          button.classList.remove('is-copied');
	          button.textContent = 'Copy URL';
	        }, 1800);
	      });
	    });

	    document.querySelectorAll<HTMLButtonElement>('.delete-asset').forEach((button) => {
	      button.addEventListener('click', async () => {
	        const id = button.dataset.deleteId;
	        if (!id || !window.confirm('Delete this asset permanently? Its URL will stop working.')) return;
	        button.disabled = true;
	        const response = await fetch(`/api/assets/${encodeURIComponent(id)}`, { method: 'DELETE' });
	        const result = await response.json().catch(() => ({ error: 'Delete failed' })) as { error?: string };
	        if (!response.ok) {
	          button.disabled = false;
	          showToast(result.error || 'Delete failed');
	          return;
	        }
	        window.sessionStorage.setItem('imagetourl-pro-flash', 'Asset deleted permanently');
	        window.location.reload();
	      });
	    });

	    const focusAssetSearch = () => {
	      document.querySelector('#recent')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
	      window.setTimeout(() => searchInput?.focus(), 350);
	    };

      const setMobileNavActive = (activeLink: HTMLAnchorElement) => {
        mobileNavLinks.forEach((link) => link.removeAttribute('aria-current'));
        activeLink.setAttribute('aria-current', 'page');
      };

      mobileNavLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          setMobileNavActive(link);
          const selector = link.getAttribute('href');
          if (!selector?.startsWith('#') || selector === '#workspace-settings') return;
          const target = document.querySelector<HTMLElement>(selector);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          window.history.replaceState(
            {},
            '',
            `${window.location.pathname}${window.location.search}${selector}`
          );
        });
      });

      const mobileSections = ['#workspace-top', '#recent', '#toolkit']
        .map((selector) => document.querySelector<HTMLElement>(selector))
        .filter((section): section is HTMLElement => Boolean(section));

      if ('IntersectionObserver' in window) {
        const mobileNavObserver = new IntersectionObserver(
          (entries) => {
            const visibleEntry = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visibleEntry) return;
            const matchingLink = document.querySelector<HTMLAnchorElement>(
              `.mobile-nav a[href="#${visibleEntry.target.id}"]`
            );
            if (matchingLink) setMobileNavActive(matchingLink);
          },
          { rootMargin: '-18% 0px -62% 0px', threshold: [0.05, 0.25, 0.5] }
        );
        mobileSections.forEach((section) => mobileNavObserver.observe(section));
      }

	    commandSearch?.addEventListener('click', focusAssetSearch);
	    newFolderButton?.addEventListener('click', () => {
	      openDialog(folderDialog);
	      window.setTimeout(() => folderName?.focus(), 50);
	    });
	    manageWorkspaceButton?.addEventListener('click', () => openDialog(workspaceDialog));
	    profileButton?.addEventListener('click', () => openDialog(workspaceDialog));
      sidebarBillingButton?.addEventListener('click', () => {
        openDialog(workspaceDialog);
        window.setTimeout(() => billingActionButton?.focus(), 80);
      });
	    document.querySelectorAll<HTMLAnchorElement>('a[href="#workspace-settings"]').forEach((link) => {
	      link.addEventListener('click', (event) => {
	        event.preventDefault();
	        openDialog(workspaceDialog);
	      });
	    });

	    document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
	      button.addEventListener('click', () => closeDialog(button.closest<HTMLDialogElement>('dialog')));
	    });
	    [folderDialog, workspaceDialog].forEach((dialog) => {
	      dialog?.addEventListener('click', (event) => {
	        if (event.target === dialog) closeDialog(dialog);
	      });
	    });

	    folderForm?.addEventListener('submit', async (event) => {
	      event.preventDefault();
	      const name = folderName?.value.trim();
	      if (!name) return;
	      const response = await fetch('/api/folders', {
	        method: 'POST',
	        headers: { 'Content-Type': 'application/json' },
	        body: JSON.stringify({ name })
	      });
	      const result = await response.json().catch(() => ({ error: 'Folder creation failed' })) as { error?: string };
	      if (!response.ok) {
	        showToast(result.error || 'Folder creation failed');
	        return;
	      }
	      window.sessionStorage.setItem('imagetourl-pro-flash', `“${name}” folder created`);
	      window.location.reload();
	    });

	    workspaceForm?.addEventListener('submit', async (event) => {
	      event.preventDefault();
	      const privateDefault = settingPrivateDefault?.checked === true;
	      const response = await fetch('/api/preferences', {
	        method: 'PUT',
	        headers: { 'Content-Type': 'application/json' },
	        body: JSON.stringify({ privateDefault })
	      });
	      const result = await response.json().catch(() => ({ error: 'Save failed' })) as { error?: string };
	      if (!response.ok) {
	        showToast(result.error || 'Save failed');
	        return;
	      }
	      privatePreference?.setAttribute('aria-pressed', String(privateDefault));
	      closeDialog(workspaceDialog);
	      showToast('Workspace preferences saved');
	    });

      const loadPaddle = async () => {
        const existing = document.querySelector<HTMLScriptElement>('script[data-paddle-js]');
        if ((window as unknown as { Paddle?: unknown }).Paddle) return;
        if (!existing) throw new Error('Paddle checkout is not configured');
        await new Promise<void>((resolve, reject) => {
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error('Paddle.js failed to load')), {
              once: true
          });
        });
      };

      const openBilling = async () => {
        if (!billingActionButton || billingActionButton.disabled) {
          openDialog(workspaceDialog);
          return;
        }
        billingActionButton.disabled = true;
        const originalLabel = billingActionButton.textContent;
        billingActionButton.textContent = 'Opening Paddle…';

        try {
          const manageExisting = billingActionButton.dataset.mode === 'portal';
          if (manageExisting) {
            const response = await fetch('/api/billing/portal', { method: 'POST' });
            const result = await response.json().catch(() => ({ error: 'Billing portal failed' })) as {
              url?: string;
              error?: string;
            };
            if (!response.ok || !result.url) throw new Error(result.error || 'Billing portal failed');
            window.location.assign(result.url);
            return;
          }

          const response = await fetch('/api/billing/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ interval: billingInterval?.value || 'month' })
          });
          const result = await response.json().catch(() => ({ error: 'Checkout failed' })) as {
            transactionId?: string;
            clientToken?: string;
            environment?: 'sandbox' | 'production';
            error?: string;
          };
          if (!response.ok || !result.transactionId || !result.clientToken || !result.environment) {
            throw new Error(result.error || 'Checkout failed');
          }

          await loadPaddle();
          const paddle = (window as unknown as {
            Paddle?: {
              Environment: { set(environment: 'sandbox'): void };
              Initialize(options: {
                token: string;
                eventCallback(event: { name?: string }): void;
              }): void;
              Checkout: {
                open(options: {
                  transactionId: string;
                  settings: {
                    displayMode: 'overlay';
                    variant: 'one-page';
                    theme: 'light';
                    locale: 'en';
                    successUrl: string;
                  };
                }): void;
              };
            };
          }).Paddle;
          if (!paddle) throw new Error('Paddle.js did not initialize');
          if (result.environment === 'sandbox') paddle.Environment.set('sandbox');
          paddle.Initialize({
            token: result.clientToken,
            eventCallback: (event) => {
              if (event.name === 'checkout.completed') {
                window.sessionStorage.setItem(
                  'imagetourl-pro-flash',
                  'Payment received. Paddle is activating your Pro workspace.'
                );
              }
            }
          });
          closeDialog(workspaceDialog);
          paddle.Checkout.open({
            transactionId: result.transactionId,
            settings: {
              displayMode: 'overlay',
              variant: 'one-page',
              theme: 'light',
              locale: 'en',
              successUrl: `${window.location.origin}/?billing=success`
            }
          });
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'Billing could not be opened');
        } finally {
          billingActionButton.disabled = false;
          billingActionButton.textContent = originalLabel;
        }
      };

      if (billingActionButton) {
        billingActionButton.addEventListener('click', openBilling);
      }

      const requestStorageChange = async (action: 'preview' | 'apply') => {
        if (!storagePackSelect) return;
        const quantity = Number(storagePackSelect.value);
        const target = action === 'preview' ? storageAddonPreview : storageAddonApply;
        if (!target) return;
        const originalLabel = target.textContent;
        target.disabled = true;
        target.textContent = action === 'preview' ? 'Calculating with Paddle…' : 'Updating storage…';
        if (storageAddonFeedback) storageAddonFeedback.textContent = '';

        try {
          const response = await fetch('/api/billing/storage-addon', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantity, action })
          });
          const result = await response.json().catch(() => ({ error: 'Storage update failed' })) as {
            ok?: boolean;
            error?: string;
            totalStorageBytes?: number;
            immediateCharge?: string | null;
            renewalTotal?: string | null;
          };
          if (!response.ok || !result.ok) throw new Error(result.error || 'Storage update failed');

          if (action === 'apply') {
            window.sessionStorage.setItem(
              'imagetourl-pro-flash',
              'Storage updated. Your new allowance is ready.'
            );
            window.location.reload();
            return;
          }

          const totalGb = Math.round(Number(result.totalStorageBytes ?? 0) / 1024 ** 3);
          const chargeCopy = result.immediateCharge
            ? `Paddle will charge ${result.immediateCharge} now, including proration and tax.`
            : 'No immediate charge is due. Paddle will apply any billing credit automatically.';
          const renewalCopy = result.renewalTotal
            ? ` Your next renewal total will be ${result.renewalTotal}.`
            : '';
          if (storageAddonPreviewCopy) {
            storageAddonPreviewCopy.textContent =
              `${chargeCopy}${renewalCopy} Your workspace allowance will become ${totalGb}GB.`;
          }
          if (storageAddonConfirm) storageAddonConfirm.hidden = false;
          storageAddonApply?.focus();
        } catch (error) {
          if (storageAddonFeedback) {
            storageAddonFeedback.textContent =
              error instanceof Error ? error.message : 'Storage could not be updated';
          }
        } finally {
          target.disabled = false;
          target.textContent = originalLabel;
        }
      };

      storageAddonPreview?.addEventListener('click', () => requestStorageChange('preview'));
      storageAddonApply?.addEventListener('click', () => requestStorageChange('apply'));
      storageAddonBack?.addEventListener('click', () => {
        if (storageAddonConfirm) storageAddonConfirm.hidden = true;
        storageAddonPreview?.focus();
      });
      storagePackSelect?.addEventListener('change', () => {
        if (storageAddonConfirm) storageAddonConfirm.hidden = true;
        if (storageAddonFeedback) storageAddonFeedback.textContent = '';
      });

	    window.addEventListener('keydown', (event) => {
	      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
	        event.preventDefault();
	        focusAssetSearch();
	      }
	    });
	  </script>
</ProShell>
