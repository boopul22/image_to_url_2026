---
export const prerender = false;

import ProMarketingShell from '../layouts/ProMarketingShell.astro';
import { proPath } from '../lib/paths';

const user = Astro.locals.proUser;
const workspaceHref = user
  ? proPath('/workspace')
  : `${proPath('/sign-in')}?return_to=${encodeURIComponent(proPath('/workspace'))}`;
---

<ProMarketingShell
  title="ImageToURL Pro — Permanent image hosting for serious work"
  description="Store original-quality images, organize them privately, and share stable HTTPS URLs from a professional ImageToURL workspace."
>
  <main class="marketing-main pro-home">
    <section class="pro-home-hero" data-pro-impression="pro-home-hero">
      <div class="pro-home-copy">
        <p class="marketing-kicker">Professional image hosting, without the infrastructure</p>
        <h1>Images that stay organized. URLs that keep working.</h1>
        <p>
          ImageToURL Pro gives creators and teams a private workspace for original-quality image
          storage, permanent HTTPS delivery URLs, folders, imports, and clear usage controls.
        </p>
        <div class="pro-home-actions">
          <a class="pro-home-primary" href={proPath('/pricing')} data-pro-event="pro_cta_clicked" data-pro-location="pro-home-hero-pricing">View Pro pricing <span aria-hidden="true">↗</span></a>
          <a class="pro-home-secondary" href={workspaceHref} data-pro-event={user ? 'pro_feature_explored' : 'pro_signin_started'} data-pro-location="pro-home-hero-workspace">{user ? 'Open workspace' : 'Sign in to Pro'}</a>
        </div>
        <p class="pro-home-proof">From $3.99/month equivalent · Unlimited storage · Cancel before renewal</p>
      </div>

      <aside class="pro-home-preview" aria-label="ImageToURL Pro workspace preview">
        <div class="pro-home-preview-top">
          <span><i aria-hidden="true"></i> Workspace</span>
          <strong>Pro</strong>
        </div>
        <div class="pro-home-drop">
          <span aria-hidden="true">↑</span>
          <strong>Drop images here</strong>
          <small>Original quality · up to 64MB each</small>
        </div>
        <div class="pro-home-file">
          <span class="pro-home-thumb" aria-hidden="true"></span>
          <span><strong>product-launch.png</strong><small>Ready · Private</small></span>
          <b>Copy URL</b>
        </div>
        <div class="pro-home-file">
          <span class="pro-home-thumb is-lavender" aria-hidden="true"></span>
          <span><strong>campaign-cover.webp</strong><small>Ready · Unlisted</small></span>
          <b>Copy URL</b>
        </div>
      </aside>
    </section>

    <section class="pro-home-value" aria-labelledby="pro-value-title">
      <div>
        <p class="marketing-kicker">What you get</p>
        <h2 id="pro-value-title">A dependable home for the images behind your work.</h2>
      </div>
      <div class="pro-home-features">
        <article>
          <span>01</span>
          <h3>Permanent delivery URLs</h3>
          <p>Share stable HTTPS links built for websites, documents, campaigns, and product workflows.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Private by default when you want it</h3>
          <p>Choose public, unlisted, or private visibility and keep every asset inside one calm workspace.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Original-quality storage</h3>
          <p>Keep source images intact, import from existing URLs, organize with folders, and monitor usage.</p>
        </article>
      </div>
    </section>

    <section class="pro-home-cta" data-pro-impression="pro-home-final">
      <div>
        <p class="marketing-kicker">Simple founding plan</p>
        <h2>Unlimited professional image storage from $3.99 per month equivalent.</h2>
        <p>Choose monthly, annual, or three-year billing. Every interval includes the same unlimited workspace.</p>
      </div>
      <a class="pro-home-primary" href={proPath('/pricing')} data-pro-event="pro_cta_clicked" data-pro-location="pro-home-final-pricing">See pricing and features <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</ProMarketingShell>
