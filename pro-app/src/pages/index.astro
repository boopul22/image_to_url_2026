        <span>Home</span>
      </a>
      <a href="#recent" aria-label="Library">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 16 3.4-3.6 2.4 2.4 2.3-2.5L19 16"/></svg>
        <span>Library</span>
      </a>
      <a href="#toolkit" aria-label="Pro tools">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 7.5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>
        <span>Tools</span>
      </a>
      <a href="#workspace-settings" aria-label="Sharing settings">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>
        <span>Settings</span>
      </a>
