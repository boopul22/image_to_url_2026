---
export const prerender = false;
import ProLegalDocument from '../components/ProLegalDocument.astro';
---

<ProLegalDocument
  title="Contact"
  eyebrow="Product, billing, and trust support"
  description="Contact ImageToURL Pro for workspace support, billing, refunds, privacy requests, or abuse reports."
  intro="Send the right details and we’ll route your question without asking you to expose passwords or card information."
>
  <section>
    <h2>Service information</h2>
    <p><strong>Product:</strong> ImageToURL Pro</p>
    <p><strong>Operator:</strong> Bipul Kumar</p>
    <p><strong>Location:</strong> India</p>
    <p><strong>Email:</strong> <a href="mailto:blog.boopul@gmail.com">blog.boopul@gmail.com</a></p>
  </section>
  <section>
    <h2>Workspace support</h2>
    <p>
      Email <a href="mailto:blog.boopul@gmail.com?subject=ImageToURL%20Pro%20support">blog.boopul@gmail.com</a>
      with your account email, asset ID or URL, what you expected, and what happened. Do not send your
      Google credentials, password, or full card number.
    </p>
  </section>
  <section>
    <h2>Billing and refunds</h2>
    <p>
      Paddle is the Merchant of Record for Pro purchases. Visit
      <a href="https://paddle.net" target="_blank" rel="noopener">paddle.net</a> for transaction support,
      cancellation help, invoices, and refund requests, or email us with your receipt number.
    </p>
    <p>See the <a href="/refund-policy">Refund Policy</a> for eligibility.</p>
  </section>
  <section>
    <h2>Privacy and abuse</h2>
    <p>
      Use “Privacy request” for account data requests and “Abuse report” for illegal, infringing,
      malicious, or unsafe content. Include the exact asset URL and supporting information.
    </p>
  </section>
  <section>
    <h2>Response time</h2>
    <p>
      We aim to acknowledge ordinary requests within two business days. Investigations may require more
      time depending on complexity, identity verification, and legal requirements.
    </p>
  </section>
</ProLegalDocument>
