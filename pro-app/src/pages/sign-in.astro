---
export const prerender = false;

import ProMarketingShell from '../layouts/ProMarketingShell.astro';
import { getProEnv } from '../lib/env';
import { proPath } from '../lib/paths';

if (Astro.locals.proUser) {
  return Astro.redirect(proPath('/workspace'), 302);
}

const env = getProEnv();
const requestedReturnTo = Astro.url.searchParams.get('return_to');
const siteOrigin = new URL(env.SITE_URL).origin;
let returnTo = new URL(proPath('/workspace'), siteOrigin).toString();
if (requestedReturnTo) {
  try {
    const candidate = new URL(requestedReturnTo, siteOrigin);
    if (
      candidate.origin === siteOrigin &&
      (candidate.pathname === proPath() || candidate.pathname.startsWith(`${proPath()}/`)) &&
      !candidate.username &&
      !candidate.password
    ) {
      returnTo = candidate.toString();
    }
  } catch {
    // Keep the safe workspace fallback.
  }
}
const authEndpoint = new URL('/api/auth/login', env.AUTH_API_ORIGIN);
authEndpoint.searchParams.set('start', 'google');
authEndpoint.searchParams.set('response', 'json');
authEndpoint.searchParams.set('return_to', returnTo);
const fallbackEndpoint = new URL(authEndpoint);
fallbackEndpoint.searchParams.delete('response');
---

<ProMarketingShell
  title="Sign in to ImageToURL Pro"
  description="Sign in securely with your existing ImageToURL account to open your Pro image workspace."
  noindex
>
  <main class="pro-auth-main">
    <section class="pro-auth-card" aria-labelledby="sign-in-heading">
      <div class="pro-auth-mark" aria-hidden="true"><span></span></div>
      <p class="marketing-kicker">Your existing ImageToURL account</p>
      <h1 id="sign-in-heading">Welcome to your Pro workspace.</h1>
      <p class="pro-auth-intro">
        Continue with the same Google account you use on ImageToURL. Your account and session are
        securely managed by the main ImageToURL authentication service.
      </p>

      <form
        id="pro-sign-in-form"
        method="get"
        action={fallbackEndpoint.toString()}
        data-auth-endpoint={authEndpoint.toString()}
      >
        <label class="pro-auth-consent">
          <input type="checkbox" name="email_updates" value="1" checked />
          <span>Email me about important account updates and occasional ImageToURL product news.</span>
        </label>
        <button class="pro-auth-button" id="pro-google-button" type="submit">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path fill="#4285f4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.06H12v3.9h5.38a4.6 4.6 0 0 1-2 3.02v2.53h3.24c1.9-1.75 2.98-4.32 2.98-7.39Z"/>
            <path fill="#34a853" d="M12 22c2.7 0 4.98-.9 6.63-2.38l-3.24-2.53c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.61A10 10 0 0 0 12 22Z"/>
            <path fill="#fbbc05" d="M6.39 13.92A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.92V7.47H3.04A10 10 0 0 0 2 12c0 1.61.38 3.14 1.04 4.53l3.35-2.61Z"/>
            <path fill="#ea4335" d="M12 5.95c1.47 0 2.78.5 3.82 1.49l2.88-2.88A9.64 9.64 0 0 0 12 2a10 10 0 0 0-8.96 5.47l3.35 2.61C7.18 7.71 9.39 5.95 12 5.95Z"/>
          </svg>
          <span>Continue with Google</span>
          <b aria-hidden="true">↗</b>
        </button>
        <p class="pro-auth-status" id="pro-auth-status" role="alert"></p>
      </form>

      <div class="pro-auth-trust">
        <span>One shared ImageToURL account</span>
        <span>Secure Google OAuth</span>
        <span>30-day session</span>
      </div>
      <p class="pro-auth-legal">
        By continuing, you agree to the <a href={proPath('/terms')}>Terms</a> and acknowledge the
        <a href={proPath('/privacy')}>Privacy Policy</a>.
      </p>
    </section>
  </main>
</ProMarketingShell>

<script>
  const form = document.querySelector<HTMLFormElement>('#pro-sign-in-form');
  const button = document.querySelector<HTMLButtonElement>('#pro-google-button');
  const status = document.querySelector<HTMLElement>('#pro-auth-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!button || !status) return;

    button.disabled = true;
    status.textContent = 'Connecting securely…';

    try {
      const endpoint = new URL(form.dataset.authEndpoint || '');
      const emailUpdates = form.querySelector<HTMLInputElement>('input[name="email_updates"]');
      endpoint.searchParams.set('email_updates', emailUpdates?.checked ? '1' : '0');

      const response = await fetch(endpoint, {
        method: 'GET',
        credentials: 'include',
        headers: { Accept: 'application/json' },
      });
      const result = await response.json() as { authorization_url?: string; error?: string };
      if (!response.ok || !result.authorization_url) {
        throw new Error(result.error || 'Unable to start sign in');
      }

      window.location.assign(result.authorization_url);
    } catch {
      button.disabled = false;
      status.textContent = 'We could not start sign in. Please try again.';
    }
  });
</script>
