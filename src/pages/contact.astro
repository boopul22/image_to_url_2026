---
export const prerender = false;
import LegalDocument from '../components/LegalDocument.astro';
---

<LegalDocument
  title="Contact ImageToURL"
  eyebrow="A real person is behind the product"
  description="Contact ImageToURL for product support, billing, refunds, privacy requests, and abuse reports."
  intro="Choose the right contact path below and include enough information for us to investigate without sending passwords or payment-card details."
>
  <section>
    <h2>Service information</h2>
    <p><strong>Product:</strong> ImageToURL and ImageToURL Pro</p>
    <p><strong>Operator:</strong> Bipul Kumar</p>
    <p><strong>Location:</strong> India</p>
    <p><strong>Support email:</strong> <a href="mailto:blog.boopul@gmail.com">blog.boopul@gmail.com</a></p>
  </section>

  <section>
    <h2>Product and account support</h2>
    <p>
      For upload, account, private-link, or workspace problems, email
      <a href="mailto:blog.boopul@gmail.com?subject=ImageToURL%20support">blog.boopul@gmail.com</a>.
      Include your account email, the affected URL or asset ID, what you expected, and what happened.
      Never send your password, Google credentials, or full payment-card number.
    </p>
  </section>

  <section>
    <h2>Billing, cancellation, and refunds</h2>
    <p>
      Paddle securely handles ImageToURL Pro transactions as Merchant of Record. Existing buyers can
      manage transaction support at <a href="https://paddle.net" target="_blank" rel="noopener">paddle.net</a>.
      You can also email us with your receipt or transaction number.
    </p>
    <p>
      Read the <a href="/refund-policy">Refund Policy</a> before submitting a refund request.
    </p>
  </section>

  <section>
    <h2>Privacy and abuse</h2>
    <p>
      Use the subject “Privacy request” for access or deletion requests. Use “Abuse report” for illegal,
      infringing, malicious, or unsafe content and include the exact ImageToURL link and supporting
      details.
    </p>
  </section>

  <section>
    <h2>Response times</h2>
    <p>
      We aim to acknowledge normal support requests within two business days. Security, abuse, and
      privacy investigations may take longer depending on complexity, identity verification, and legal
      requirements.
    </p>
  </section>
</LegalDocument>
