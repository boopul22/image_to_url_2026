import LegalDocument from '../components/LegalDocument.astro';
---

<LegalDocument
  title="Acceptable Use Policy"
  eyebrow="Keep the service safe and useful"
  description="Rules for content and behavior permitted on ImageToURL free hosting and ImageToURL Pro."
  intro="ImageToURL is built for legitimate image hosting and delivery. These rules protect users, rights holders, and the infrastructure we share."
>
  <section>
    <h2>1. You must have the right to upload</h2>
    <p>
      Upload only content you created, own, or are authorized to store and distribute. Do not use
      ImageToURL to infringe copyrights, trademarks, privacy, publicity, confidentiality, or other rights.
    </p>
  </section>

  <section>
    <h2>2. Prohibited content</h2>
    <p>You may not upload, host, import, or distribute content that:</p>
    <ul>
      <li>Is illegal or facilitates illegal activity.</li>
      <li>Sexually exploits or endangers children, including child sexual abuse material.</li>
      <li>Contains non-consensual intimate imagery, sexual extortion, or voyeuristic content.</li>
      <li>Credibly threatens, harasses, or promotes violence against a person or protected group.</li>
      <li>Contains malware, phishing material, credential theft, malicious redirects, or deceptive downloads.</li>
      <li>Exposes highly sensitive personal information without authorization.</li>
      <li>Impersonates another person or organization in a deceptive or harmful way.</li>
      <li>Infringes intellectual-property or other legal rights.</li>
    </ul>
  </section>

  <section>
    <h2>3. Prohibited behavior</h2>
    <ul>
      <li>Do not evade upload, delivery, account, rate, or security controls.</li>
      <li>Do not automate the service through undocumented endpoints or scrape private areas.</li>
      <li>Do not interfere with security controls, probe for vulnerabilities without written permission, or disrupt the service.</li>
      <li>Do not use image links for spam, phishing, fraudulent advertising, or abusive traffic schemes.</li>
      <li>Do not resell access or operate a competing hosting service through a personal Pro workspace without written agreement.</li>
      <li>Do not generate traffic primarily to exhaust resources, attack another service, or create disproportionate operational risk.</li>
    </ul>
  </section>

  <section>
    <h2>4. Enforcement</h2>
    <p>
      We may investigate reports and use automated or manual signals to identify abuse. Depending on
      severity, we may restrict delivery, quarantine or remove content, limit features, suspend an account,
      or terminate access. Urgent threats, illegal content, compromised accounts, and serious abuse may be
      acted on without advance notice.
    </p>
    <p>
      We may preserve and disclose relevant information when reasonably necessary to comply with law,
      enforce our agreements, or protect users and the public.
    </p>
  </section>

  <section>
    <h2>5. Reporting abuse or infringement</h2>
    <p>
      Email <a href="mailto:blog.boopul@gmail.com?subject=ImageToURL%20abuse%20report">blog.boopul@gmail.com</a>
      with the image URL, the reason for the report, your contact information, and supporting evidence.
      Copyright reports should identify the protected work, the allegedly infringing URL, the rights
      holder, and a good-faith statement that the use is unauthorized.
    </p>
    <p>Knowingly false or misleading reports may themselves violate this policy.</p>
  </section>
</LegalDocument>
