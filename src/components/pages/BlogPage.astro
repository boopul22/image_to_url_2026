---
import Icon from '../Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { t } from '../../i18n/utils';
import { defaultLocale } from '../../i18n/config';
import type { Locale } from '../../i18n/config';
import { getDB } from '../../lib/db';
import { getPublishedPostsLocalized, getCategories } from '../../lib/cms';
import { imgUrl } from '../../lib/img';

const locale: Locale = Astro.locals.locale ?? defaultLocale;

function lp(path: string): string {
  return `/${locale}${path}`;
}

// ISR: Cache at CDN edge for 5 min, serve stale up to 1 hour while revalidating
Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

// Degrade gracefully when the (local) D1 has empty/missing cms tables —
// fall back to an empty blog list instead of a 500. Mirrors HomePage.astro.
let posts: Awaited<ReturnType<typeof getPublishedPostsLocalized>>['posts'] = [];
let categories: Awaited<ReturnType<typeof getCategories>> = [];
try {
  const db = getDB(Astro.locals);
  ({ posts } = await getPublishedPostsLocalized(db, locale, { limit: 50 }));
  categories = await getCategories(db);
} catch (err) {
  // No DB binding / empty tables (e.g. credential-free local dev) — empty list.
  console.error('blog index load failed', err);
}

const featuredPost = posts[0] ?? null;
const otherPosts = featuredPost ? posts.slice(1) : [];

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

---

<Layout title={t(locale, 'blog.meta.title')} description={t(locale, 'blog.meta.description')} noindex={posts.length === 0}>
  <Nav activePage="blog" />

  <main class="blog-magazine bg-background">
    <!-- Magazine masthead adapted from boopul22/tts. -->
    <section>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-8 sm:pt-16 sm:pb-10">
        <span class="inline-flex items-center gap-2 border-2 border-outline bg-surface-container-lowest px-3 py-1 mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          <span class="blog-kicker">{t(locale, 'blog.badge')}</span>
        </span>
        <div class="flex items-baseline flex-wrap gap-x-4 gap-y-1">
          <h1 class="font-headline text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.06em] leading-[0.92] text-on-background">
            {t(locale, 'blog.hero.title1')} {t(locale, 'blog.hero.title2')}
          </h1>
          {posts.length > 0 && <span class="blog-byline">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>}
        </div>
        <p class="mt-5 text-base sm:text-lg leading-relaxed text-on-surface-variant max-w-[58ch]">
          {t(locale, 'blog.hero.description')}
        </p>

        {categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-7" id="category-filters">
            <button data-category="all" class="is-active blog-filter">{t(locale, 'blog.filter.all')} ({posts.length})</button>
            {categories.map((cat) => (
              <button data-category={cat.id} class="blog-filter">
                {cat.name}
              </button>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Lead story: copy the TTS cover-story composition, keep ImageToURL data. -->
    {featuredPost && (
      <section>
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
          <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 lg:gap-12 items-stretch">
            <div class="flex flex-col justify-center order-2 lg:order-1">
              <div class="flex items-center gap-3 mb-5">
                <span class="blog-cover-label">{t(locale, 'blog.badge')}</span>
                <span class="blog-kicker">{featuredPost.categoryName || t(locale, 'blog.uncategorized')}</span>
              </div>
              <a href={lp(`/blog/${featuredPost.slug}`)} class="group">
                <h2 class="font-headline text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.045em] leading-[1.02] text-on-background group-hover:text-primary transition-colors">
                  {featuredPost.title}
                </h2>
              </a>
              <p class="mt-4 text-[0.95rem] leading-relaxed text-on-surface-variant max-w-[58ch] line-clamp-3">{featuredPost.excerpt}</p>
              <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 blog-byline">
                <span>{featuredPost.authorName}</span>
                <span class="w-1 h-1 bg-outline-variant"></span>
                {featuredPost.publishedAt && <time datetime={featuredPost.publishedAt}>{formatDate(featuredPost.publishedAt)}</time>}
                <span class="w-1 h-1 bg-outline-variant"></span>
                <span>{featuredPost.readTime}</span>
              </div>
              <div class="mt-8">
                <a href={lp(`/blog/${featuredPost.slug}`)} class="blog-story-button">
                  {t(locale, 'blog.readMore')}
                  <Icon name="arrow_forward" class="text-lg" />
                </a>
              </div>
            </div>

            <a href={lp(`/blog/${featuredPost.slug}`)} class="group order-1 lg:order-2 block">
              <div class={`h-56 sm:h-72 lg:h-full min-h-[16rem] border-2 border-outline overflow-hidden ${featuredPost.iconBg || 'bg-surface-container-highest'} flex items-center justify-center relative`}>
                {featuredPost.coverImage ? (
                  <img
                    src={imgUrl(featuredPost.coverImage, 800)}
                    srcset={`${imgUrl(featuredPost.coverImage, 600)} 600w, ${imgUrl(featuredPost.coverImage, 1000)} 1000w`}
                    sizes="(min-width: 1024px) 42vw, 100vw"
                    alt={featuredPost.title}
                    width="800"
                    height="600"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <Icon name={featuredPost.iconFallback || 'article'} class="text-7xl text-on-surface/20" />
                )}
              </div>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Equal editorial cards, mobile first. -->
    {otherPosts.length > 0 && (
      <section class="cv-auto">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-outline-variant">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
            {otherPosts.map((post) => (
              <article class="post-card h-full" data-category-id={post.categoryId || ''}>
                <a href={lp(`/blog/${post.slug}`)} class="blog-mag-card group flex flex-col h-full bg-surface-container-lowest border-2 border-outline">
                  <div class={`aspect-[4/3] overflow-hidden border-b-2 border-outline ${post.iconBg || 'bg-surface-container-highest'} flex items-center justify-center relative`}>
                    {post.coverImage ? (
                      <img
                        src={imgUrl(post.coverImage, 500)}
                        srcset={`${imgUrl(post.coverImage, 400)} 400w, ${imgUrl(post.coverImage, 800)} 800w`}
                        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
                        alt={post.title}
                        width="500"
                        height="375"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    ) : (
                      <Icon name={post.iconFallback || 'article'} class="text-6xl text-on-surface/20" />
                    )}
                  </div>
                  <div class="flex flex-col gap-2 p-4 flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <span class="blog-kicker">{post.categoryName || t(locale, 'blog.uncategorized')}</span>
                      {post.publishedAt && <time class="blog-byline" datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
                    </div>
                    <h2 class="text-base sm:text-lg font-headline font-semibold tracking-tight leading-snug text-on-background group-hover:text-primary transition-colors line-clamp-2">{post.title}</h2>
                    <p class="text-sm text-on-surface-variant leading-relaxed line-clamp-3 flex-1">{post.excerpt}</p>
                    <div class="flex items-center justify-between mt-1 blog-byline">
                      <span>{post.readTime}</span>
                      <Icon name="arrow_forward" class="text-base text-outline group-hover:text-primary group-hover:translate-x-0.5 transition-all" />
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {posts.length === 0 && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-t border-outline-variant text-center">
        <Icon name="article" class="text-5xl text-outline mb-4" />
        <p class="font-headline text-xl font-semibold text-on-background">No articles yet.</p>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .blog-kicker,
  .blog-byline {
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .blog-kicker { color: var(--color-primary); }
  .blog-byline { color: var(--color-on-surface-variant); }
  .blog-cover-label {
    padding: 0.3rem 0.65rem;
    color: var(--color-on-primary);
    background: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .blog-filter {
    padding: 0.45rem 0.75rem;
    color: var(--color-on-background);
    background: var(--color-surface-container-lowest);
    border: 2px solid var(--color-outline);
    border-radius: 0 !important;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .blog-filter:hover { background: var(--color-surface-container-high); }
  .blog-filter.is-active {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }
  .blog-story-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    color: var(--color-inverse-on-surface);
    background: var(--color-inverse-surface);
    border: 2px solid var(--color-outline);
    box-shadow: 4px 4px 0 var(--color-outline);
    font-family: var(--font-headline);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }
  .blog-story-button:hover {
    background: var(--color-primary);
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--color-outline);
  }
  .blog-mag-card {
    border-radius: 0 !important;
    box-shadow: 4px 4px 0 var(--color-outline);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .blog-mag-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-outline);
  }
</style>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('#category-filters button'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.category;
      filters.forEach((item) => item.classList.toggle('is-active', item === button));
      cards.forEach((card) => {
        card.hidden = category !== 'all' && card.dataset.categoryId !== category;
      });
    });
  });
</script>
